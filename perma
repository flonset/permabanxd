-- прямой выстрел (шитаро fire_gun 3576 / KITI fn75): Shoot ремоут у
-- тулки или внутри подпапки Events; bypass — наш хук не переписывает
local function fireGun(gun, startCF, aimCF)
    if not gun or not startCF or not aimCF then return false end
    local remote = gun:FindFirstChild("Shoot")
    if not remote then
        local ev = gun:FindFirstChild("Events")
        remote = ev and ev:FindFirstChild("Shoot") or nil
    end
    if not remote or not remote:IsA("RemoteEvent") then return false end
    autoFire.bypass = true
    local okF = pcall(function() remote:FireServer(startCF, aimCF) end)
    autoFire.bypass = false
    if okF then
        local nowc = os.clock()
        autoFire.lastShot = nowc
        desyncSafeUntil = nowc + 0.15
        aimShotMark.aim = aimCF.Position
        aimShotMark.at = nowc
    end
    return okF
end

-- шаг автозала (auto_step шитаро 3583)
local function autoStep()
    if not aimState.AutoShoot or not clientAlive() then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local head = nearestTargetHead(true, aimState.Distance)
    if not head then return end
    local tchar = head.Parent
    local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")
    if not thum or thum.Health <= 0 then return end
    -- пистолет: в руках или в рюкзаке. Не в руках — ЭКИПИРУЕМ и стреляем
    -- в следующий тик (шитаро 3597–3601)
    local gun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
    if not gun then
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        local bgun = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver"))
        if not bgun then return end
        pcall(function() hum:EquipTool(bgun) end)
        return
    end
    local nowc = os.clock()
    local hold = math.max(aimState.AutoDelay or 0, autoFire.gapSeen and autoFire.gap or 0)
    if autoFire.lastShot > 0 and nowc - autoFire.lastShot < hold then return end
    if aimState.ForceShot and forceOriginCF and forceAimCF then
        -- форс: коридор считается в RenderStepped выше, аттач встаёт в
        -- его начало, выстрел прямой (KITI ForceShootAttempt 9467)
        disableCantShoot(gun)
        pushOrigin(forceOriginCF)
        fireGun(gun, forceOriginCF, forceAimCF)
        return
    end
    -- обычный автозалп: только с чистой линией огня (KITI fn30 8593:
    -- рейкаст до цели; за стену не стреляем — сервер отклонит и палевно)
    local att = gunAttachment()
    local origin = att and att.WorldCFrame.Position
        or (char:FindFirstChild("RightHand") and char.RightHand.Position)
        or (char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position)
    if not origin then return end
    local aimPt = silentPoint or pickPoint(origin, head)
    if not aimPt or not aimLosClear(origin, aimPt, tchar) then return end
    fireGun(gun, CFrame.new(origin), CFrame.new(aimPt))
end

-- GunFired: учим реальный кулдаун выстрела (шитаро on_gun_fired 3538)
local function onGunFired(tool)
    if typeof(tool) ~= "Instance" then return end
    local char = LocalPlayer.Character
    if not char then return end
    local okD, mine = pcall(function() return tool:IsDescendantOf(char) end)
    if not (okD and mine) then return end
