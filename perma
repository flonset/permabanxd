        or t == Enum.AccessoryType.Face or t == Enum.AccessoryType.Neck
        or t == Enum.AccessoryType.Eyebrow or t == Enum.AccessoryType.Eyelash
end

-- спрятать/показать родную ногу
local function setNativeLegVisible(char, sideList, visible)
    for _, name in ipairs(sideList) do
