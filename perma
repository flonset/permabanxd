        Val.Position = UDim2.new(1, -72, 0, yPos)
        Val.BackgroundTransparency = 1
        Val.Text = string.format("%.2f", default)
        Val.TextColor3 = Theme.Text
        Val.Font = FontMed
        Val.TextSize = 11
        Val.TextXAlignment = Enum.TextXAlignment.Right
        Val.Parent = parent

        local Track = Instance.new("Frame")
        Track.Size = UDim2.new(1, -24, 0, 6)
        Track.Position = UDim2.new(0, 12, 0, yPos + 18)
        Track.BackgroundColor3 = Theme.Gray
        Track.BorderSizePixel = 0
        Track.Parent = parent
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((default - min) / math.max(max - min, 0.0001), 0, 1, 0)
        Fill.BackgroundColor3 = Theme.Blue
        Fill.BorderSizePixel = 0
        Fill.Parent = Track
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

        if isHue then
            local segments = 30
            for i = 1, segments do
                local seg = Instance.new("Frame")
                seg.Size = UDim2.new(1 / segments, 1, 1, 0)
                seg.Position = UDim2.new((i - 1) / segments, 0, 0, 0)
                seg.BackgroundColor3 = Color3.fromHSV((i - 1) / segments, 1, 1)
                seg.BorderSizePixel = 0
                seg.Parent = Fill
            end
            Fill.Size = UDim2.new(1, 0, 1, 0)
        end

        local Knob = Instance.new("Frame")
        Knob.Size = UDim2.new(0, 14, 0, 14)
        Knob.AnchorPoint = Vector2.new(0.5, 0.5)
        Knob.Position = UDim2.new((default - min) / math.max(max - min, 0.0001), 0, 0.5, 0)
        Knob.BackgroundColor3 = Theme.White
        Knob.BorderSizePixel = 0
        Knob.ZIndex = Track.ZIndex + 5
        Knob.Parent = Track
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
        local KnobStroke = Instance.new("UIStroke", Knob)
        KnobStroke.Color = Theme.Sep
        KnobStroke.Transparency = 0.2

        local down = false
        local function update(pos)
            local rel = math.clamp((pos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            local v = min + rel * (max - min)
            if not isHue then Fill.Size = UDim2.new(rel, 0, 1, 0) end
            Knob.Position = UDim2.new(rel, 0, 0.5, 0)
            Val.Text = string.format("%.2f", v)
            if onChange then onChange(v) end
        end
        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then down = true; update(input.Position) end
        end)
        UISConn(UserInputService.InputChanged, function(input)
            if down and input.UserInputType == Enum.UserInputType.MouseMovement then update(input.Position) end
        end)
        UISConn(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then down = false end
        end)
    end

