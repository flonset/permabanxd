        local HKStroke = Instance.new("UIStroke", HKnob)
        HKStroke.Color = Theme.Sep
        HKStroke.Transparency = 0.2

        local function apply()
            SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            Knob.Position = UDim2.new(s, 0, 1 - v, 0)
            HKnob.Position = UDim2.new(h, 0, 0.5, 0)
            onChange(Color3.fromHSV(h, s, v))
        end

        local svDown, hueDown = false, false
        SV.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                svDown = true
                s = math.clamp((input.Position.X - SV.AbsolutePosition.X) / math.max(SV.AbsoluteSize.X, 1), 0, 1)
                v = 1 - math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / math.max(SV.AbsoluteSize.Y, 1), 0, 1)
                apply()
            end
        end)
        HueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                hueDown = true
                h = math.clamp((input.Position.X - HueBar.AbsolutePosition.X) / math.max(HueBar.AbsoluteSize.X, 1), 0, 1)
                apply()
            end
        end)
        UISConn(UserInputService.InputChanged, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            if svDown then
                s = math.clamp((input.Position.X - SV.AbsolutePosition.X) / math.max(SV.AbsoluteSize.X, 1), 0, 1)
                v = 1 - math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / math.max(SV.AbsoluteSize.Y, 1), 0, 1)
                apply()
            elseif hueDown then
                h = math.clamp((input.Position.X - HueBar.AbsolutePosition.X) / math.max(HueBar.AbsoluteSize.X, 1), 0, 1)
                apply()
            end
        end)
        UISConn(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                svDown, hueDown = false, false
            end
        end)

        apply()

        -- программная установка цвета (при смене роли в дропдауне)
        return function(c)
            h, s, v = c:ToHSV()
            apply()
        end
    end

