                flingRows[pl] = nil
            end
        end
        local n = 0
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer then
                local r = flingRows[pl]
                if not r then
                    r = buildFlingRow(pl, n)
                    flingRows[pl] = r
                else
                    r.Btn.LayoutOrder = n
                end
                n = n + 1
                local rl, rc = flingRowRole(pl)
                if r.RoleLbl.Text ~= rl then
                    r.RoleLbl.Text = rl
                    r.RoleLbl.TextColor3 = rc
                    r.Dot.BackgroundColor3 = rc
                end
            end
        end
        FlingList.Size = UDim2.new(1, -10, 0, n * 40)
        local tpY = flingY + n * 40 + 6
        FlingTPBtn.Position = UDim2.new(0, 0, 0, tpY)
        ContentTabs["Fling"].CanvasSize = UDim2.new(0, 0, 0, tpY + 50)
    end

