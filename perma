UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightAlt then
        if ScreenGui and MainFrame then
            local newState = not MainFrame.Visible
            MainFrame.Visible = newState
            if AvatarLabel then AvatarLabel.Visible = newState end
            if newState then
                PlayJelly(MainFrame)
                if SettingsGui then SettingsGui.Enabled = true end
            else
                if Tooltip then Tooltip.Visible = false end
                for _, w in ipairs(SettingsWindows) do
                    w.Visible = false
                end
                if SettingsGui then SettingsGui.Enabled = false end
            end
        end
    end
end)

