-- 1.5 АВТО-КОНФИГ (встроен, отключить нельзя)
-- Каждые 3 сек все состояния пишутся в permaban_config.json
-- (папка workspace экзекутора). При запуске файл читается ДО
-- построения GUI — тогглы/слайдеры/дропдауны сразу встают в
-- сохранённые позиции. Нет writefile/readfile — тихо работает
-- без сохранения, ничего не падает.
-- ==========================================
local HttpService = game:GetService("HttpService")
local CFG_FILE = "permaban_config.json"
local SavedConfig = {}
pcall(function()
    if type(readfile) ~= "function" then return end
    if type(isfile) == "function" and not isfile(CFG_FILE) then return end
    local raw = readfile(CFG_FILE)
    if type(raw) == "string" and #raw > 2 then
        local dec = HttpService:JSONDecode(raw)
        if type(dec) == "table" then SavedConfig = dec end
    end
end)

local themeName = "Brown"    -- коричневая тема по умолчанию
-- чтение ТОЛЬКО через rawget: статический анализатор (ProjectReal) считает
-- SavedConfig пустой таблицей и кидает TypeError "Key not found" на любые
-- .theme/.hat — через вызов функции он ничего статически проверить не может
do
    local sTheme = type(SavedConfig) == "table" and rawget(SavedConfig, "theme") or nil
    if type(sTheme) == "table" then
        local nm = rawget(sTheme, "Name")
        if type(nm) == "string" and Themes[nm] then
            themeName = nm
        end
    end
end

