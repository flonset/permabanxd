    -- ВЕРТИКАЛЬНАЯ РАСКЛАДКА окна: строки при раскрытии
    -- спускают всё, что ниже (высота окна пересчитывается)
    -- ==========================================
    local function NewVLayout(win, startY)
        local rows = {}
        local y = startY
        local function relayout()
            y = startY
            for _, r in ipairs(rows) do
                r.f.Position = UDim2.new(0, 12, 0, y)
                y = y + r.h + 8
            end
            win.Size = UDim2.new(0, 230, 0, math.max(y + 6, startY + 40))
        end
        local function AddRow(h)
            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, -24, 0, h)
            f.Position = UDim2.new(0, 12, 0, y)
            f.BackgroundTransparency = 1
            f.ClipsDescendants = true
            f.Parent = win
            local row = { f = f, h = h }
            table.insert(rows, row)
            relayout()
            return row, relayout
        end
        -- таблица, а не функция: AddExpandSlider зовёт lay.AddRow(...)
        return { AddRow = AddRow }
    end

    -- слайдер со стрелочкой-дропдауном: клик по стрелке разворачивает
    -- доп. настройки функции под слайдером и спускает все настройки ниже
    local function AddExpandSlider(win, lay, label, min, max, default, onChange, extraH, buildExtra)
        local row, relayout = lay.AddRow(40)
        AddMiniSlider(row.f, 0, label, min, max, default, false, onChange)

