local function cfgEncode(v)
    if typeof and typeof(v) == "Color3" then
        return { __color = { v.R, v.G, v.B } }
    end
    if type(v) == "table" then
        local t = {}
        for k, vv in pairs(v) do t[k] = cfgEncode(vv) end
        return t
    end
    if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
        return v
    end
    return nil   -- инстансы/функции в конфиг не пишем
end

