local function clearKorbloxLeg(char, side)
    for _, obj in ipairs(korbloxMounted[side]) do
        pcall(function() obj:Destroy() end)
    end
    korbloxMounted[side] = {}
    local list = (side == "Right") and FAKE_KORBLOX_PARTS or FAKE_KORBLOX_PARTS_LEFT
    setNativeLegVisible(char, list, true)
    korbloxState[side] = false
end

-- надеть настоящий меш ноги Deathspeaker (только на твоём клиенте).
-- грузим ассет из каталога прямо на клиенте через GetObjects и
-- привариваем к родным частям ноги; родные части прячем
local function mountKorbloxLeg(char, side)
    local id = KORBLOX_LEG_IDS[side .. "Leg"]

    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if not ok or type(objs) ~= "table" or #objs == 0 then
        warn("[PERMABAN] Korblox " .. side .. ": не удалось загрузить меш " .. tostring(id))
        return false
    end

    -- собираем все MeshParts из ассета
    local meshes = {}
    for _, root in ipairs(objs) do
        if root:IsA("MeshPart") then table.insert(meshes, root) end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("MeshPart") then table.insert(meshes, d) end
        end
    end
    if #meshes == 0 then
        warn("[PERMABAN] Korblox " .. side .. ": в ассете нет мешей")
        return false
    end

    local upper = char:FindFirstChild(side .. "UpperLeg")
    local mounted = {}
    local matchedByName = false

    -- вариант 1: в ассете сегменты с теми же именами (R15-упаковка)
    -- варим каждый сегмент к своей родной части
    for _, m in ipairs(meshes) do
        if m.Name:find(side) then
            local native = char:FindFirstChild(m.Name)
            if native and native:IsA("BasePart") then
                matchedByName = true
                m.CanCollide = false
                m.CanQuery = false
                m.CanTouch = false
                m.Anchored = false
                m.Massless = true
                m.CFrame = native.CFrame
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = native
                weld.Part1 = m
                weld.Parent = m
                m.Parent = char
                table.insert(mounted, m)
            end
        end
    end

    -- вариант 2: пришёл один цельный меш ноги — ставим верхом к бедру
    if not matchedByName and upper then
        local m = meshes[1]
        m.CanCollide = false
        m.CanQuery = false
        m.CanTouch = false
        m.Anchored = false
        m.Massless = true
        m.CFrame = upper.CFrame * CFrame.new(0, upper.Size.Y / 2 - m.Size.Y / 2, 0)
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = upper
        weld.Part1 = m
        weld.Parent = m
        m.Parent = char
        table.insert(mounted, m)
    end

    if #mounted == 0 then
        warn("[PERMABAN] Korblox " .. side .. ": не нашлось куда приварить")
        return false
    end

    korbloxMounted[side] = mounted
    local list = (side == "Right") and FAKE_KORBLOX_PARTS or FAKE_KORBLOX_PARTS_LEFT
    setNativeLegVisible(char, list, false)
    korbloxState[side] = true
    return true
end

-- главный переключатель: надеть/снять ноги по тогглам.
-- ApplyDescription тут НЕ используем: с клиента на своём
-- персонаже она всегда кидает «can only be called by the
-- backend server», поэтому она и не работала
local function syncKorblox()
    local char = LocalPlayer.Character
    if not char then return end

    local wantRight = fakeState.Enabled and fakeState.RightKorblox or false
    local wantLeft  = fakeState.Enabled and fakeState.LeftKorblox or false

    if wantRight ~= korbloxState.Right then
        if wantRight then
            mountKorbloxLeg(char, "Right")
        else
            clearKorbloxLeg(char, "Right")
        end
    end
    if wantLeft ~= korbloxState.Left then
        if wantLeft then
            mountKorbloxLeg(char, "Left")
        else
            clearKorbloxLeg(char, "Left")
        end
    end
end

