-- bg.jpg (сжатый 1024px JPEG) зашит в скрипт base64-строкой: скрипт сам
-- пишет файл в воркспейс экзекутора через writefile и отдаёт его
-- getcustomasset — никакой зависимости от того, куда юзер положил файл,
-- и никаких онлайн-запросов. Декодер чисто арифметический (без bit32),
-- поэтому работает на любом экзекуторе.
local BG_B64 = ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""
    .. ""

local B64D = {}
do
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, #chars do B64D[chars:byte(i)] = i - 1 end
end

local function b64decode(data)
    -- '=' добивает хвост: терминируем сразу
    local eq = data:find("=", 1, true)
    if eq then data = data:sub(1, eq - 1) end
    local out, buf, bits = {}, 0, 0
    for i = 1, #data do
        local v = B64D[data:byte(i)]
        if v then
            buf = buf * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                out[#out + 1] = string.char(math.floor(buf / 2 ^ bits) % 256)
                buf = buf % (2 ^ bits)
            end
        end
    end
    return table.concat(out)
end

-- возвращает путь, который потом скормить getcustomasset, или nil
local function ensureBgFile()
    if type(isfile) == "function" then
        for _, p in ipairs({ "bg.jpg", "workspace/bg.jpg" }) do
            local okF, found = pcall(isfile, p)
            if okF and found then return p end
        end
    end
    if type(writefile) ~= "function" then return nil end
    local okD, raw = pcall(b64decode, BG_B64)
    if not okD or type(raw) ~= "string" or #raw < 1000 then return nil end
    for _, p in ipairs({ "bg.jpg", "workspace/bg.jpg" }) do
        local okW = pcall(writefile, p, raw)
        if okW then
            if type(isfile) ~= "function" then return p end
            local okF, found = pcall(isfile, p)
            if okF and found then return p end
        end
    end
    return nil
end

