-- ==========================================
-- 3D. AIM (вкладка Target): Basic + Silent, режим — дропдаун в окне
-- Basic: при зажатой ПКМ камера притягивается к ближайшей живой голове.
-- Silent: перехватываем Raycast / FindPartOnRay у workspace и разворачиваем
-- луч выстрела в голову ближайшей цели — камера не двигается.
-- Работает для пистолета (рейкаст-оружие); метательный нож физический —
-- это не рейкаст, его срайлентить так нельзя.
-- ==========================================
local aimState = {
    Enabled = false,
    Mode = "Basic",      -- "Basic" | "Silent"
    Distance = 250,
    PingPredict = true,  -- авто-упреждение по пингу (тумблер в окне SHERIFF)
    Predict = 0,         -- доп. упреждение поверх пинга, сек
    ForceShot = false,   -- форс шот из шитаро: выстрел сквозь стены; работает
                         -- САМ ПО СЕБЕ (без Sheriff-аима) и ВМЕСТЕ с ним
    ForceStandOff = 15,  -- отлёт старта коридора от цели, студы
    AutoShoot = false,   -- автозалп (шитаро auto_step / KITI fn30): стреляет
                         -- по мардеру сама, пистолет экипирует из рюкзака
    AutoDelay = 0.12     -- пауза между выстрелами автозалпа, сек
}

-- НОЖ: аима больше НЕТ вообще (и хоткея T тоже). Логика мардера —
-- только хитбокс-экспандер ниже: летящий нож сам задевает расширенные
-- боксы игроков, никакой подмены траектории
-- АВТО-ПИНГ — один в один из дампа шитаро (raw_rtt 3009 / sample_ping 3026 /
-- lead_time 3041). Пинг сам меряется и сглаживается, ручных множителей нет:
-- Data Ping из Stats + GetNetworkPing*2, берём среднее, EMA сглаживание,
-- упреждение = rtt + джиттер/2. Работает само при любом пинге
local StatsService = game:GetService("Stats")
local pingEC = { rtt = 0, jitter = 0, seen = false }

local function raw_rtt()
    local a, b
    local ok, ms = pcall(function()
        return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(ms) == "number" and ms == ms and ms > 4 and ms < 800 then
        a = ms / 1000
    end
    local fine, value = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if fine and type(value) == "number" and value == value and value > 0 then
        local rtt = value * 2
        if rtt > 0.004 and rtt < 0.8 then b = rtt end
    end
    if a and b then return (a + b) * 0.5 end
    return a or b
end

local function samplePing()
    local rtt = raw_rtt()
    if not rtt or rtt ~= rtt then return end
    rtt = math.clamp(rtt, 0, 1)
    if pingEC.seen then
        pingEC.jitter = pingEC.jitter * 0.9 + math.abs(rtt - pingEC.rtt) * 0.1
        pingEC.rtt = pingEC.rtt * 0.82 + rtt * 0.18
    else
        pingEC.rtt = rtt
        pingEC.jitter = 0
        pingEC.seen = true
    end
end

task.spawn(function()
    while true do
        samplePing()
        task.wait(0.1)
    end
end)

local function leadTime()
    if not pingEC.seen then return 0 end
    return math.clamp(pingEC.rtt + pingEC.jitter * 0.5, 0, 1)
end

-- проверка пистолета: аим работает ТОЛЬКО за шерифа.
-- В MM2 тулка может зваться Gun или Revolver (старые версии — Revolver),
-- проверяем обе (так же делает retpirato-скрипт: findsheriff ищет Revolver ИЛИ Gun)
local function localHasGun()
    local char = LocalPlayer.Character
    if char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")) then return true end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    return bp ~= nil and (bp:FindFirstChild("Gun") ~= nil or bp:FindFirstChild("Revolver") ~= nil)
end

-- нож у тебя (мардер)
local function localHasKnife()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Knife") then return true end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    return bp ~= nil and bp:FindFirstChild("Knife") ~= nil
end

-- чужой Backpack клиенту не реплицируется, роль цели — только по персонажу
local function charHasWeapon(pl, weapon)
    local char = pl.Character
    return char ~= nil and char:FindFirstChild(weapon) ~= nil
end

-- цель для пистолета: нож в персонаже ИЛИ роль Murderer с сервера
-- (GetPlayerData). Пока мардер не доставал нож, аим молчал — серверная
-- роль видит цель сразу после старта раунда
local function isMurderTarget(pl)
    if charHasWeapon(pl, "Knife") then return true end
    local ok, role = pcall(roleOf, pl)
    return ok and role == "Murderer"
end

-- ближайшая живая голова под фильтр.
-- wantMurderer: nil = любой игрок (нож мардера), true = только убийцы (пистолет шерифа)
local function nearestTargetHead(wantMurderer, maxDist)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local camPos = cam.CFrame.Position
    local best, bestDist = nil, maxDist or aimState.Distance
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            if wantMurderer == nil or isMurderTarget(pl) then
                local char = pl.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local head = char and char:FindFirstChild("Head")
                if head and hum and hum.Health > 0 then
                    local d = (head.Position - camPos).Magnitude
                    if d < bestDist then
                        best, bestDist = head, d
                    end
                end
            end
        end
    end
    return best
end

-- точка упреждения, по логике KITI fn26 (7142):
-- время = упреждение + авто-пинг (leadTime) + дистанция/BULLET_SPEED,
-- BULLET_SPEED в MM2 = 300.
-- ФИКС ДЖАМПЕРОВ: авто-пинг считается РОВНО один раз на вызов, а в
-- вертикальной дуге — наполовину. Член -0.5*g*t² квадратичен: раньше
-- полный RTT в общем t (пинг + travel в одной куче) давал перелив
-- вниз на 5–6 студов по Y на джампе. Горизонталь осталась на полном t.
-- ==========================================
-- ФОРМУЛЫ АИМА — портировано из шитаро (predict_from 3095 / fit_kin 2608 /
-- dir_stats 3057 / ground_below 2757), переменные мои.
-- Кольцевой буфер позиций цели → квадратичная регрессия даёт скорость И
-- ускорение (игроки в MM2 двигаются стрейфом и зигзагами — чистая скорость
-- по AssemblyLinearVelocity промахивается). Ускорение с капами
-- acc_max/acc_min, скорость — капом smax*speed_head (пик цели + запас),
-- повороты предсказываются через когерентность направления (dir_stats),
-- вертикаль — честная дуга с гравитацией и клампом по полу (ground_below).
-- ==========================================
local AIM_P = {
    ring = 48,          -- размер кольца позиций/направлений
    acc_t = 0.15,       -- время форса ускорения, сек
    acc_max = 280,      -- кап ускорения, студы/с²
    acc_min = 40,       -- ниже — шум, ускорение игнорируем
    speed_floor = 26,   -- минимальный запас скорости капа
    speed_head = 1.3,   -- множитель пикового скорости цели
    jump_v = 50,        -- стартовая скорость прыжка MM2
    clearance = 2.2     -- зазор ног над полом для клампа
}

local snapT, snapP = {}, {}
local snapN, snapI = 0, 0
local SK = { n = 0, i = 0, t = {}, dx = {}, dz = {} }
local aimKin = { ok = false, ax = 0, az = 0, smax = 0 }
local aimTR = { ready = false, vel = Vector3.zero, air = false,
    air_since = 0, jumping = false, time = 0, gap = 0.033,
    gbase = 0, gseen = false, spoof = 0 }  -- зазор ноги-пол (GC шитаро)
                                           -- + счётчик подмены скорости
local aimTargetPart = nil
local aimStep = 0.033   -- сглаженный шаг сэмплинга (EC.step шитаро)

local function aimClear()
    snapN, snapI = 0, 0
    SK.n, SK.i = 0, 0
    aimKin.ok = false
    aimKin.ax, aimKin.az, aimKin.smax = 0, 0, 0
    aimTR.ready = false
    aimTR.vel = Vector3.zero
    aimTR.air = false
    aimTR.jumping = false
    aimTR.air_since = 0
    aimTR.gbase, aimTR.gseen = 0, false
    aimTR.spoof = 0
    aimTargetPart = nil
end

local function sampleSpan()
    local span = math.max(aimStep, aimTR.gap)
    if span <= 0 then return 0 end
    return span
end

local function snapPush(now, pos)
    snapI = snapI % AIM_P.ring + 1
    snapT[snapI] = now
    snapP[snapI] = pos
    if snapN < AIM_P.ring then snapN = snapN + 1 end
end

local function snapGet(k)
    local idx = (snapI - k - 1) % AIM_P.ring + 1
    return snapT[idx], snapP[idx]
end

local function velPush(now, hx, hz)
    SK.i = SK.i % AIM_P.ring + 1
    SK.t[SK.i] = now
    SK.dx[SK.i] = hx
    SK.dz[SK.i] = hz
    if SK.n < AIM_P.ring then SK.n = SK.n + 1 end
end

-- квадратичная регрессия X/Z по кольцу (fit_kin шитаро): решает
-- 3x3-систему нормальных уравнений, вытаскивает скорость и ускорение
local function fitKin()
    if snapN < 5 then return nil end
    local t0 = snapGet(0)
    local win = math.max(sampleSpan() * 5, 0.12)
    local scale = win
    local n, s1, s2, s3, s4 = 0, 0, 0, 0, 0
    local bx0, bx1, bx2 = 0, 0, 0
    local bz0, bz1, bz2 = 0, 0, 0
    for k = 0, snapN - 1 do
        local t, p = snapGet(k)
        local age = t0 - t
        if age > win then break end
        local u = -age / scale
        local u2 = u * u
        n = n + 1
        s1 = s1 + u
        s2 = s2 + u2
        s3 = s3 + u2 * u
        s4 = s4 + u2 * u2
        bx0 = bx0 + p.X
        bx1 = bx1 + p.X * u
        bx2 = bx2 + p.X * u2
        bz0 = bz0 + p.Z
        bz1 = bz1 + p.Z * u
        bz2 = bz2 + p.Z * u2
    end
    if n < 5 then return nil end
    local det = n * (s2 * s4 - s3 * s3)
        - s1 * (s1 * s4 - s3 * s2)
        + s2 * (s1 * s3 - s2 * s2)
    if math.abs(det) < 1e-9 then return nil end
    local function solve(b0, b1, b2)
        local d1 = n * (b1 * s4 - s3 * b2)
            - b0 * (s1 * s4 - s3 * s2)
            + s2 * (s1 * b2 - b1 * s2)
        local d2 = n * (s2 * b2 - b1 * s3)
            - s1 * (s1 * b2 - b1 * s2)
            + b0 * (s1 * s3 - s2 * s2)
        return d1 / det, d2 / det
    end
    local cx1, cx2 = solve(bx0, bx1, bx2)
    local cz1, cz2 = solve(bz0, bz1, bz2)
    local vx, vz = cx1 / scale, cz1 / scale
    local ax, az = 2 * cx2 / (scale * scale), 2 * cz2 / (scale * scale)
    if vx ~= vx or vz ~= vz or ax ~= ax or az ~= az then return nil end
    return Vector3.new(vx, 0, vz), Vector3.new(ax, 0, az)
end

-- обновление Kin: пиковая скорость (smax) с затуханием 0.985/0.015
-- и ускорение с капом acc_max
local function kinUpdate()
    local kv, ka = fitKin()
    if not kv then
        aimKin.ok = false
        aimKin.ax, aimKin.az = 0, 0
        return
    end
    aimKin.ok = true
    local sp = math.sqrt(kv.X * kv.X + kv.Z * kv.Z)
    if sp > aimKin.smax then
        aimKin.smax = sp
    else
        aimKin.smax = aimKin.smax * 0.985 + sp * 0.015
    end
    if ka and not aimTR.air then
        local am = math.sqrt(ka.X * ka.X + ka.Z * ka.Z)
        local ax, az = ka.X, ka.Z
        if am > AIM_P.acc_max and am > 0 then
            ax = ax * AIM_P.acc_max / am
            az = az * AIM_P.acc_max / am
        end
        if am < AIM_P.acc_min then
            ax, az = 0, 0
        end
        aimKin.ax, aimKin.az = ax, az
    else
        aimKin.ax, aimKin.az = 0, 0
    end
end

-- когерентность направления и угловая скорость поворота (dir_stats шитаро):
-- насколько прямолинейно бежит цель и с какой скоростью крутится
local function dirStats(win)
    if SK.n < 4 then return 1, 0 end
    win = math.max(win, sampleSpan() * 3)
    local newest = SK.t[SK.i]
    local sx, sz, n = 0, 0, 0
    local prev, turn, turn_n = nil, 0, 0
    local oldest = newest
    for k = 0, SK.n - 1 do
        local idx = (SK.i - k - 1) % AIM_P.ring + 1
        local t = SK.t[idx]
        if newest - t > win then break end
        local hx, hz = SK.dx[idx], SK.dz[idx]
        local m = math.sqrt(hx * hx + hz * hz)
        if m > 0 then
            sx = sx + hx / m
            sz = sz + hz / m
            n = n + 1
            local ang = math.atan2(hz, hx)
            if prev then
                local d = ang - prev
                while d > math.pi do d = d - 6.2831853 end
                while d < -math.pi do d = d + 6.2831853 end
                turn = turn + d
                turn_n = turn_n + 1
            end
            prev = ang
            oldest = t
        end
    end
    if n < 2 then return 1, 0 end
    local coh = math.clamp(math.sqrt(sx * sx + sz * sz) / n, 0, 1)
    local omega = 0
    local elapsed = newest - oldest
    if turn_n >= 1 and elapsed > 1e-3 then
        omega = -turn / elapsed
    end
    return coh, omega
end

local function rotateY(v, ang)
    local c, s = math.cos(ang), math.sin(ang)
    return Vector3.new(v.X * c - v.Z * s, v.Y, v.X * s + v.Z * c)
end

-- пол под экстраполированной точкой (ground_below шитаро): чтобы дуга
-- прыжка не уводила прицел под землю
local aimGroundParams = RaycastParams.new()
aimGroundParams.FilterType = Enum.RaycastFilterType.Exclude
local function groundBelow(pos, reach, targetChar)
    local f = {}
    local n = 0
    if targetChar then n = n + 1 f[n] = targetChar end
    local mine = LocalPlayer.Character
    if mine then n = n + 1 f[n] = mine end
    if tracerFolder then n = n + 1 f[n] = tracerFolder end
    aimGroundParams.FilterDescendantsInstances = f
    rayBypass = true
    local okR, res = pcall(workspace.Raycast, workspace, pos, Vector3.new(0, -reach, 0), aimGroundParams)
    rayBypass = false
    if okR and res then return res.Position.Y end
    return nil
end

-- predict_from шитаро: горизонталь — ускорение/когерентность/кап скорости,
-- вертикаль — дуга с modeled-прыжком и клампом по полу
local function predictFrom(base, span, now, targetChar)
    local g = workspace.Gravity or 196.2
    local fh = Vector3.new(aimTR.vel.X, 0, aimTR.vel.Z)
    local x, z
    if span > 0 and aimKin.ok then
        -- ветка ускорения: экcтраполируем v(t) = v0 + a*t с капами
        local age = math.clamp(now - aimTR.time, 0, sampleSpan() * 2)
        local ax, az = aimKin.ax, aimKin.az
        if aimTR.air or math.sqrt(ax * ax + az * az) < AIM_P.acc_min then ax, az = 0, 0 end
        local vx = fh.X + ax * age
        local vz = fh.Z + az * age
        local ta = math.min(span, AIM_P.acc_t)
        local dx = vx * span + 0.5 * ax * ta * ta
        local dz = vz * span + 0.5 * az * ta * ta
        local reach = math.sqrt(dx * dx + dz * dz)
        local cap = math.max(aimKin.smax * AIM_P.speed_head, AIM_P.speed_floor) * span
        if reach > cap and reach > 1e-6 then
            dx = dx * cap / reach
            dz = dz * cap / reach
        end
        x = base.X + dx
        z = base.Z + dz
    else
        -- ветка когерентности: цель крутится — поворачиваем вектор движения
        -- на половину угловой скорости * время, дистанцию жмём по доверию
        local hspan = span
        if span > 0 and fh.Magnitude > 0 and not aimTR.air then
            local coh, omega = dirStats(span)
            local conf = math.clamp(coh, 0, 1)
            if omega ~= 0 then
                fh = rotateY(fh, math.clamp(omega * span * 0.5 * conf, -0.6, 0.6))
            end
            hspan = span * (0.85 + 0.15 * conf)
        end
        x = base.X + fh.X * hspan
        z = base.Z + fh.Z * hspan
    end
    local y = base.Y + aimTR.vel.Y * 0.05
    if aimTR.air and span > 0 then
        -- честная дуга: modeled-прыжок сильнее фактической скорости в начале
        local vy = aimTR.vel.Y
        local phase = math.max(0, now - aimTR.air_since)
        local modeled = AIM_P.jump_v - g * phase
        if aimTR.jumping and AIM_P.jump_v > 0 and g > 0
            and phase <= AIM_P.jump_v / g and modeled > vy then
            vy = modeled
        end
        y = base.Y + vy * span - 0.5 * g * span * span
        if y < base.Y then
            local reach = base.Y - y + AIM_P.clearance
            local gy = groundBelow(Vector3.new(x, base.Y, z), reach, targetChar)
            if gy then
                local floorY = gy + AIM_P.clearance
                if y < floorY then y = floorY end
            end
        end
    end
    return Vector3.new(x, y, z)
end

-- сэмплер цели: Heartbeat кладёт позицию головы активной цели в кольцо,
-- считает gap/воздух/повороты. Считает ВСЕГДА, когда аим включён и есть
-- цель — хукам и камере остаются только чистые чтения готовых таблиц
task.spawn(function()
    while true do
        local dt = task.wait()
        local now = os.clock()
        if dt > 0 and dt < 1 then
            aimStep = aimStep * 0.85 + dt * 0.15
        end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) or not aimState.Enabled
            or not clientAlive() then
            aimClear()
        else
            local head = nearestTargetHead(true, aimState.Distance)
            if not head then
                aimClear()
            else
                if head ~= aimTargetPart then
                    aimClear()
                    aimTargetPart = head
                end
                -- воздух/прыжок цели: гуманоид-стейт + рейкаст под ногами
                -- (шитаро track_fresh 2880): стейт с сервера запаздывает,
                -- зазор ноги-пол честнее; «стоячий» зазор учим (GC шитаро)
                local thum = head.Parent and head.Parent:FindFirstChildOfClass("Humanoid")
                if thum then
                    local st = thum:GetState()
                    local airNow = st == Enum.HumanoidStateType.Freefall
                        or st == Enum.HumanoidStateType.Jumping
                    if airNow and not aimTR.air then aimTR.air_since = now end
                    local tchar = head.Parent
                    local hrpA = tchar and tchar:FindFirstChild("HumanoidRootPart")
                    if hrpA then
                        local reach = AIM_P.clearance + 6
                            + math.abs(aimTR.vel.Y) * sampleSpan() * 4
                        local gy = groundBelow(hrpA.Position, reach, tchar)
                        if gy then
                            local clr = hrpA.Position.Y - gy
                            if not airNow and math.abs(aimTR.vel.Y) < 1 then
                                if aimTR.gseen then
                                    if clr < aimTR.gbase then
                                        aimTR.gbase = aimTR.gbase * 0.7 + clr * 0.3
                                    else
                                        aimTR.gbase = aimTR.gbase * 0.98 + clr * 0.02
                                    end
                                else
                                    aimTR.gbase = clr
                                    aimTR.gseen = true
                                end
                            end
                            local floorClr = aimTR.gseen and aimTR.gbase or AIM_P.clearance
                            local tol = math.max(floorClr * 0.35, 1)
                            if clr > floorClr + tol then airNow = true end
                        else
                            airNow = true   -- под ногами пола нет — в воздухе
                        end
                    end
                    aimTR.air = airNow
                    aimTR.jumping = st == Enum.HumanoidStateType.Jumping
                end
                -- gap между сэмплами + направление в SK-кольцо
                if snapN > 0 then
                    local _, prevPos = snapGet(0)
                    local g2 = math.clamp(now - snapT[snapI], 0.005, 0.5)
                    aimTR.gap = g2
                    local d = head.Position - prevPos
                    if g2 > 0.001 then
                        velPush(now, d.X / g2, d.Z / g2)
                    end
                end
                snapPush(now, head.Position)
                -- запасная скорость от движка, пока регрессия не готова,
                -- с проверкой на подмену (шитаро vel_trust 2773): если
                -- AssemblyLinearVelocity не совпадает со скоростью по
                -- позиции (десынк/спуф цели) — движку не верим совсем,
                -- предикт держится на регрессии по позиции
                local hrp = head.Parent and head.Parent:FindFirstChild("HumanoidRootPart")
                if hrp and not aimTR.air then
                    local okE, ev = pcall(function() return hrp.AssemblyLinearVelocity end)
                    if okE and typeof(ev) == "Vector3" then
                        local eh = Vector3.new(ev.X, 0, ev.Z)
                        local pv = Vector3.new(aimTR.vel.X, 0, aimTR.vel.Z)
                        local em, pm = eh.Magnitude, pv.Magnitude
                        local trust
                        if em < 1 and pm < 1 then
                            trust = true   -- оба стоят — верим
                        elseif em >= 1 and pm >= 1 then
                            local ratio = em / pm
                            local align = eh.Unit:Dot(pv.Unit)
                            trust = ratio > 0.6 and ratio < 1.5 and align > 0.7
                        else
                            trust = false
                        end
                        if trust then
                            aimTR.spoof = math.max(0, aimTR.spoof - 1)
                            aimTR.vel = Vector3.new(ev.X, ev.Y, ev.Z)
                        elseif aimTR.spoof < 20 then
                            aimTR.spoof = aimTR.spoof + 1
                        end
                    end
                end
                aimTR.time = now
                kinUpdate()
                local kv = fitKin()
                if kv then
                    aimTR.vel = kv
                    aimTR.ready = true
                end
            end
        end
    end
end)

-- точка упреждения для аима шерифа: время = ручной слайдер + авто-пинг,
-- геометрия — predictFrom выше
local function predictPoint(head, extraSec, usePing)
    local now = os.clock()
    local ping = 0
    if usePing and aimState.PingPredict then ping = leadTime() end
    local span = (extraSec or 0) + ping
    if span <= 0 then return head.Position end
    return predictFrom(head.Position, span, now, head.Parent)
end

-- ==========================================
-- LOS-ТРАССИРОВКА И ВЫБОР ТОЧКИ — порт из шитаро (trace 2403 /
-- los_clear 3290 / pick_point 3304 / refresh_ignore 2388).
-- Рейкаст пропускает ПОЛНОСТЬЮ прозрачные парты (стёкла, зоны) до
-- 6 отскоков и парты с тегом WeaponPassthrough (игра сама считает
-- их простреливаемыми). pickPoint перебирает части тела цели с
-- общим упреждением и отдаёт первую с чистой линией огня — голова
-- за углом больше не означает гарантированный промах
-- ==========================================
local AIM_HIT_NAMES = {
    "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head",
    "Right Arm", "Left Arm", "RightUpperArm", "LeftUpperArm",
    "Right Leg", "Left Leg", "RightLowerLeg", "LeftLowerLeg",
}
local aimTraceParams = RaycastParams.new()
aimTraceParams.FilterType = Enum.RaycastFilterType.Exclude
local aimTaggedList = {}
local aimTagTime = 0

-- трассировка с пропуском прозрачного (шитаро trace): список игнора
-- растёт на каждую прозрачную парту, максимум 6 отскоков
local function aimTrace(origin, dir)
    local nowc = os.clock()
    if nowc - aimTagTime > 0.5 then
        aimTagTime = nowc
        pcall(function()
            local tagged = game:GetService("CollectionService"):GetTagged("WeaponPassthrough")
            table.clear(aimTaggedList)
            if type(tagged) == "table" then
                for i = 1, #tagged do aimTaggedList[i] = tagged[i] end
            end
        end)
    end
    local dist = dir.Magnitude
    if dist < 0.05 then return nil end
    local unit = dir / dist
    local f = {}
    local n = 0
    local mine = LocalPlayer.Character
    if mine then n = n + 1 f[n] = mine end
    if tracerFolder then n = n + 1 f[n] = tracerFolder end
    for i = 1, #aimTaggedList do f[n + i] = aimTaggedList[i] end
    rayBypass = true
    local org, left = origin, dist
    local res = nil
    for _ = 1, 6 do
        aimTraceParams.FilterDescendantsInstances = f
        local okR, r = pcall(workspace.Raycast, workspace, org, unit * left, aimTraceParams)
        if not okR or not r then
            res = nil
            break
        end
        local inst = r.Instance
        local tr = nil
        if inst then
            local okT, tv = pcall(function() return inst.Transparency end)
            if okT then tr = tv end
        end
        if tr ~= 1 then
            res = r
            break
        end
        -- прозрачная парты: прыгаем за её задний край и ищем дальше
        n = n + 1
        f[n] = inst
        local step = (r.Position - org).Magnitude + 0.5
        org = org + unit * step
        left = left - step
        if left <= 0.05 then
            res = nil
            break
        end
    end
    rayBypass = false
    return res
end

-- LOS между двумя точками: чисто / попали в цель / почти дошли
local function aimLosClear(origin, point, targetChar)
    local d = point - origin
    if d.Magnitude < 0.5 then return true end
    local hit = aimTrace(origin, d)
    if not hit then return true end
    local inst = hit.Instance
    if inst and targetChar and (inst == targetChar or inst:IsDescendantOf(targetChar)) then return true end
    return (hit.Position - origin).Magnitude >= d.Magnitude - 0.75
end

-- pick_point шитаро: перебор частей тела с общим упреждением,
-- первая с чистой линией огня. Лимит 8 парт — худший случай дёшев
local function pickPoint(origin, head)
    local tchar = head.Parent
    if not tchar then return nil end
    local off = Vector3.zero
    local hrp = tchar:FindFirstChild("HumanoidRootPart")
    if hrp and aimTR.ready then
        local span = (aimState.Predict or 0) + (aimState.PingPredict and leadTime() or 0)
        if span > 0.001 then
            local okP, shifted = pcall(predictFrom, hrp.Position, span, os.clock(), tchar)
            if okP and shifted then off = shifted - hrp.Position end
        end
    end
    local first = nil
    local scanned = 0
    for i = 1, #AIM_HIT_NAMES do
        local part = tchar:FindFirstChild(AIM_HIT_NAMES[i])
        if part and part:IsA("BasePart") then
            local pt = part.Position + off
            if not first then first = pt end
            scanned = scanned + 1
            if scanned > 8 then break end
            if aimLosClear(origin, pt, tchar) then return pt end
        end
    end
    return first
end

-- ==========================================
-- 3E. HITBOX EXPANDER (вкладка Target) — только за МАРДЕРА
-- v2.37: возврат к проверенному ресайзу HumanoidRootPart (работал в
-- v2.27–v2.29), но БЕЗ причин лагов старой версии:
--  • ресайз ТОЛЬКО когда размер отличается от целевого (идемпотентно):
--    риг не пересобирается каждый цикл — персонажи не дёргаются;
--  • CanQuery=false: рейкасты (окклюзия камеры, аим) гигантский HRP не
--    видят — камера не прыгает;
--  • CanCollide=false: с гуманоидом не воюем, коллизию держат конечности;
--  • Massless=true: увеличенный HRP не меняет инерцию сборки цели.
-- Почему НЕ сварной бокс v2.33–v2.36: касания летящего ножа считает
-- клиент бросающего (наш), а игра на нём проверяет, ВО ЧТО врезался
-- нож, по имени парта/по персонажу — «PermaBanHitbox» такие фильтры не
-- проходил, попадания молча терялись («не работает»). Настоящий
-- HumanoidRootPart проходит ЛЮБОЙ фильтр: по имени, по гуманоиду, по
-- предку-персонажу. К тому же сварная схема зависела от тегирования
-- ножа по ТОЧНОМУ имени тулки (WEAPON_ROLE_MAP): не совпало имя — и нож
-- навсегда оставался в Default-группе, у которой с боксом коллизии
-- выключены. Исходный размер HRP запоминается ровно один раз и
-- возвращается при выключении/смерти/выходе игрока; размеры с клиента
-- не реплицируются — сервер и другие игроки видят обычный HRP. За
-- шерифа экспандера НЕТ: сервер валидирует луч пистолета по настоящему
-- HRP цели, локальный размер ему не виден.
-- ==========================================
local hitboxState = { Enabled = false, Size = 30 }
local lastHitboxRestore = 0   -- os.clock() последнего отката хитбоксов: guard для Velocity Desync

-- исходные размеры HRP: [Player] = Vector3 до первого расширения
local hbOriginal = {}

local function hbExpand(pl, size)
    local char = pl.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local target = Vector3.new(size, size, size)
    if hbOriginal[pl] then
        if hrp.Size == target then return end   -- уже расширено — ноль работы, ноль лагов
    else
        hbOriginal[pl] = hrp.Size   -- исходник запоминаем РОВНО один раз
    end
    pcall(function()
        hrp.Size = target
        hrp.Massless = true      -- инерция сборки цели не меняется
        hrp.CanCollide = false   -- с гуманоидом не воюем: коллизия на конечностях
        hrp.CanTouch = true      -- Touched летящего ножа обязан ловиться
        hrp.CanQuery = false     -- рейкасты камеры/аима сквозь бокс — камера не прыгает
        hrp.Transparency = 1
    end)
end

local function hbRestore(pl)
    local char = pl.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local orig = hbOriginal[pl]
    if hrp and orig then
        pcall(function()
            hrp.Size = orig
            hrp.Massless = false
            hrp.CanQuery = true
            hrp.CanTouch = true
        end)
    end
    hbOriginal[pl] = nil
    lastHitboxRestore = os.clock()
end

Players.PlayerRemoving:Connect(function(pl)
    hbOriginal[pl] = nil
end)

-- мы мардер? нож у нас по имени ИЛИ серверная роль == Murderer (имя
-- тулки в сборках игры отличается, серверная роль надёжнее)
local function hbIAmMurderer()
    if localHasKnife() then return true end
    local ok, role = pcall(roleOf, LocalPlayer)
    return ok and role == "Murderer"
end

task.spawn(function()
    while true do
        if hitboxState.Enabled and clientAlive() and hbIAmMurderer() then
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl ~= LocalPlayer then
                    hbExpand(pl, hitboxState.Size)
                end
            end
        else
            for _, pl in ipairs(Players:GetPlayers()) do
                hbRestore(pl)
            end
        end
        task.wait(0.1)
    end
end)

