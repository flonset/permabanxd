        Arrow.Font = FontBold
        Arrow.TextSize = 12
        Arrow.Parent = row.f

        local extra = Instance.new("Frame")
        extra.Size = UDim2.new(1, 0, 0, extraH)
        extra.Position = UDim2.new(0, 0, 0, 40)
        extra.BackgroundTransparency = 1
        extra.Visible = false
        extra.Parent = row.f

        local expanded = false
        local built = false
        Arrow.MouseButton1Click:Connect(function()
            expanded = not expanded
            Arrow.Text = expanded and "v" or ">"
            if expanded then
                if not built then buildExtra(extra); built = true end
                row.h = 40 + extraH
                extra.Visible = true
            else
                row.h = 40
                extra.Visible = false
            end
            relayout()
        end)
        return row
    end

