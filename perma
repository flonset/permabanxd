-- ==========================================
-- FORCESHOT — портировано из шитаро (resolve_force 3379 / force_clear 3367),
-- переменные мои. Строит "коридор" выстрела: старт ищется позади цели по
-- направлению её движения с ЧИСТОЙ линией огня (LOS-проба каждые 3 студа,
-- отлёт до ForceStandOff), прицел — конец коридора. gun.Shoot:FireServer
-- получает start_cf/aim_cf из коридора — выстрел летит сквозь стены
-- ==========================================
local FORCE_MIN_SPAN = 5    -- минимальная длина коридора (min_span шитаро)
local FORCE_MAX_SPAN = 90   -- максимальная длина (max_span шитаро)

local function forceRaycast(o, d)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local f = {}
    local n = 0
    local char = LocalPlayer.Character
    if char then n = n + 1 f[n] = char end
    if tracerFolder then n = n + 1 f[n] = tracerFolder end
    params.FilterDescendantsInstances = f
    -- рейкаст под флагом: наш же Silent-хук не должен разворачивать
    -- LOS-пробу коридора в голову цели
    rayBypass = true
    local okR, res = pcall(workspace.Raycast, workspace, o, d, params)
    rayBypass = false
    return okR and res or nil
end

-- force_clear шитаро: трассируем по линии и смотрим, попали ли в цель.
-- v2.38: LOS через aimTrace — прозрачные парты и WeaponPassthrough
-- коридор не глушат (в v2.37 стеклянные зоны считались стеной и
-- коридор по ним не строился)
local function forceClearToTarget(origin, aim, targetChar)
    local d = aim - origin
    if d.Magnitude < 0.05 then return true end
    local hit = aimTrace(origin, d)
    if not hit then return true end
    return targetChar ~= nil and (hit.Instance == targetChar or hit.Instance:IsDescendantOf(targetChar))
end

-- LOS между двумя точками: стены глушат, стекло — нет
local function forceLosClear(a, b)
    local d = b - a
    if d.Magnitude < 0.05 then return true end
    return aimTrace(a, d) == nil
end

-- resolve_force шитаро (фолбэк-ветка + stand-off проба):
-- направление коридора = скорость цели (или линия до нас, если стоит)
local function resolveForce()
    local head = nearestTargetHead(true, aimState.Distance)
    if not head then return nil, nil end
    local targetChar = head.Parent
    local hrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local live = head.Position
    local vel = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
    local dir = Vector3.new(0, -1, 0)
    if vel.Magnitude > 3 then
        dir = vel.Unit
    else
        local mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
        if mine then
            local delta = live - mine.Position
            if delta.Magnitude > 2 then dir = delta.Unit end
        end
    end
    -- back/front коридора: чуть позади цели и далеко вперёд по движению
    local back = live - dir * 6
    local front = live + dir * math.max(FORCE_MIN_SPAN, vel.Magnitude * leadTime() + 8)
    if not forceClearToTarget(back, front, targetChar) then
        back = live - dir * 2.5
    end
    -- stand-off: отодвигаем старт назад, пока линия огня не откроется.
    -- Проверяем LOS и до цели, и до упреждённой точки (шитаро 3400:
    -- los_clear(probe, mark) + los_clear(probe, live)) — иначе коридор
    -- открыт сейчас, а пуля летит в упреждённую точку сквозь стену
    local anchor = live
    if aimTR.ready then
        local span = leadTime()
        if span > 0.001 then
            local okA, shifted = pcall(predictFrom, live, span, os.clock(), targetChar)
            if okA and shifted then anchor = shifted end
        end
    end
    local origin = back
    local want = aimState.ForceStandOff or 15
    while want > 0 do
        local probe = live - dir * want
        if (front - probe).Magnitude <= FORCE_MAX_SPAN
            and forceLosClear(probe, live) and forceLosClear(probe, anchor) then
            origin = probe
            break
        end
        want = want - 3
    end
    return CFrame.new(origin, front), CFrame.new(front)
end

-- кэш коридора: RenderStepped считает, хук FireServer только читает
RunService.RenderStepped:Connect(function()
    forceOriginCF, forceAimCF = nil, nil
    if not clientAlive() then return end
    -- форс шот теперь САМОСТОЯТЕЛЬНЫЙ: коридор строится и без включённого
    -- Sheriff-аима — иначе тогл Force Shot в SHERIFF ничего не делал
    if not aimState.ForceShot then return end
    if not localHasGun() then return end
    local okF, o, a = pcall(resolveForce)
    if okF and o and a then
        forceOriginCF, forceAimCF = o, a
    end
end)

-- ==========================================
-- PUSH ORIGIN / CANTSHOOT / АВТОШОТ — из дампов:
--  • push_origin (шитаро 3341 / restore 3328 / KITI 9340–9369): старт
--    выстрела игра берёт из WorldCFrame аттача GunRaycastAttachment
--    на HumanoidRootPart. Ставим аттач в точку коридора, игра
--    отправляет серверу start_cf оттуда, аттач возвращается в ТОТ ЖЕ
--    кадр (task.defer) — картинка не дёргается
--  • CantShoot (KITI 9489): локальная блокировка выстрела снимается
--    перед форс-выстрелом
--  • автозалп (шитаро auto_step 3583 / KITI fn30): пистолет сам
--    экипируется из рюкзака, реальный кулдаун учимся у события
--    WeaponService.GunFired (gap_push 2295), выстрел — прямой
--    Shoot:FireServer(start, aim)
-- ==========================================
local forceAtt, forceSaved = nil, nil
local forceStamp = 0

local function restoreOrigin()
    local att = forceAtt
    if not att then return end
    local saved = forceSaved
    forceAtt, forceSaved = nil, nil
    if saved then
        pcall(function()
            if att.Parent then att.CFrame = saved end
        end)
    end
end

local function gunAttachment()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    return hrp:FindFirstChild("GunRaycastAttachment")
end

local function pushOrigin(cf)
    local att = gunAttachment()
    if not att then return false end
    if forceAtt and forceAtt ~= att then restoreOrigin() end
    if not forceAtt then
        local okS, saved = pcall(function() return att.CFrame end)
        if not okS or typeof(saved) ~= "CFrame" then return false end
        forceAtt, forceSaved = att, saved
    end
    forceStamp = os.clock()
    local okW = pcall(function() att.WorldCFrame = cf end)
    if not okW then
        restoreOrigin()
        return false
    end
    task.defer(restoreOrigin)
    return true
end

