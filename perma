-- ==========================================
-- 3F. INVIS (вкладка Target) — МЕТОД INFINITE YIELD (;invisible, автор
-- приёма AmokahFox), доработанный под эту игру. Как работает:
--  • делаем Archivable и КЛОНИРУЕМ своего персонажа — клон существует
--    только на нашем клиенте, сервер и другие игроки его не видят;
--  • оригинал больше НЕ улетает за край мира. В v2.34–v2.35 телепорт на
--    3 141 592 студов реплицировался (сервер видел невозможный перелёт),
--    а CharacterAdded-хэндлер путал «сервер дал новое тело» с «мы сами
--    назначили клона» (LocalPlayer.Character = clone ТОЖЕ стреляет
--    CharacterAdded) и через 0.3с УНИЧТОЖАЛ живого клона — отсюда
--    «пол секунды инвиза нормальные, потом я просто пропадаю». Теперь
--    оригинал ПАРКУЕТСЯ на 12 студов ПОД точку включения (короткий
--    телепорт, который сервер не флажит — механика проверена в
--    v2.25–v2.29) и анкорится: стоит под полом как AFK-тело;
--  • клон встаёт на наше место и назначается LocalPlayer.Character:
--    ходьба, камера, анимации — как у обычного персонажа, но всё это
--    происходит только у нас; для остальных ты исчез с карты;
--  • гардиан раз в 0.1с ЧИНИТ, а не ломает: сервер вернул Character на
--    оригинала — забираем обратно на живого клона; сервер вытащил тело
--    из парковки — прячем заново; камеру сбили — возвращаем на клона;
--  • смерть клона, провал под FallenPartsDestroyHeight, потеря клона или
--    НАСТОЯЩИЙ респавн от сервера = МЯГКИЙ выход через единую процедуру
--    invisRestore (камера на живое тело, тоггл гаснет) — «остаться без
--    тела» невозможно в принципе;
--  • при выключении оригинал тепается в позицию, куда дошёл клон
--    (логика «возвращения куда дошёл» из v2.26–v2.29), клон уничтожается,
--    камера возвращается на гуманоида.
-- Отличия от канонического iY: прозрачность клона из слайдера Self alpha
-- (в iY жёстко 0.5), парковка под полом вместо запредельного телепорта,
-- единая процедура возврата для ручного и любого авто-выключения.
-- ==========================================
local INVIS_PARK_DEPTH = 12   -- глубина парковки оригинала под найденным полом

local invisState = { Enabled = false, Busy = false, Invisible = false,
    Original = nil, Clone = nil, DiedConn = nil, Gen = 0, ParkY = nil }
invisState.Ghost = invisState.Ghost or 0.65   -- прозрачность клона (видишь только ты)
local invisUIOff = nil    -- хук: UI позже подставит сюда сброс визуала тоггла

local ghostState = { Folder = nil, Map = nil, Char = nil }   -- на него ссылаются фильтры рейкастов

-- полное выметание состояния (без возврата персонажа)
local function invisCleanup()
    if invisState.DiedConn then
        pcall(function() invisState.DiedConn:Disconnect() end)
        invisState.DiedConn = nil
    end
    if invisState.Clone and invisState.Clone.Parent then
        pcall(function() invisState.Clone:Destroy() end)
    end
    invisState.Clone = nil
    invisState.Original = nil
    invisState.Invisible = false
    invisState.Busy = false
end

-- рестарт скрипта Animate на персонаже (клонированный Animate может не
-- завестись сам — трюк из iY: Disabled true → false)
local function restartAnimate(model)
    local anim = model and model:FindFirstChild("Animate")
    if not anim then return end
    pcall(function()
        anim.Disabled = true
        task.wait()
        anim.Disabled = false
    end)
end

-- ЕДИНАЯ процедура возврата: оригинал тепается туда, куда дошёл клон,
-- клон уничтожается, камера на гуманоида оригинала. Используется и ручным
-- выключением, и всеми авто-выходами — «остаться без тела» невозможно
local function invisRestore(reason)
    local wasInvis = invisState.Invisible or invisState.Clone ~= nil
    invisState.Gen = (invisState.Gen or 0) + 1
    local myGen = invisState.Gen
    if invisState.Busy then
        -- ВКЛ ещё в полёте (task.wait внутри pcall): догоняем его и
        -- выключаем после — иначе тоггл OFF во время ON терялся бы
        task.spawn(function()
            for _ = 1, 50 do
                task.wait(0.1)
                if not invisState.Busy then break end
            end
            if not invisState.Busy and invisState.Gen == myGen and invisState.Invisible then
                pcall(invisRestore, reason)
            end
        end)
        return
    end
    invisState.Busy = true
    pcall(function()
        local clone = invisState.Clone
        local original = invisState.Original
        if invisState.DiedConn then
            pcall(function() invisState.DiedConn:Disconnect() end)
            invisState.DiedConn = nil
        end
        -- если тело кто-то снял с парента (не уничтожая) — вернём в workspace
        if original and not original.Parent then
            local okP = pcall(function() original.Parent = workspace end)
            if not okP then original = nil end   -- уничтожен — восстановить нельзя
        end
        local cam = workspace.CurrentCamera
        local camCF = cam and cam.CFrame
        -- куда дошёл клон — там и появляемся (логика v2.26 сохранилась)
        local destCF
        local chrp = clone and clone:FindFirstChild("HumanoidRootPart")
        if chrp then destCF = chrp.CFrame end
        if clone and clone.Parent then clone:Destroy() end
        invisState.Clone = nil
        if original and original.Parent then
            local ohrp = original:FindFirstChild("HumanoidRootPart")
            if ohrp then
                if destCF then
                    ohrp.CFrame = destCF
                else
                    -- клона нет (потерян/ошибка включения) — поднимаем тело
                    -- на поверхность из парковки, а не роняем под картой
                    local baseY = invisState.ParkY
                    if baseY then
                        ohrp.CFrame = CFrame.new(ohrp.Position.X,
                            baseY + INVIS_PARK_DEPTH, ohrp.Position.Z)
                    end
                end
                ohrp.AssemblyLinearVelocity = Vector3.zero
                ohrp.AssemblyAngularVelocity = Vector3.zero
                ohrp.Anchored = false   -- отвязка строго после телепорта
            end
            LocalPlayer.Character = original
            local ohum = original:FindFirstChildOfClass("Humanoid")
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                if ohum then pcall(function() cam.CameraSubject = ohum end) end
                if camCF then pcall(function() cam.CFrame = camCF end) end
            end
            restartAnimate(original)
        else
            -- оригинала больше нет (сервер сменил персонажа) — камера на то,
            -- что сервер дал сейчас
            invisCleanup()
            local c = LocalPlayer.Character
            local nh = c and c:FindFirstChildOfClass("Humanoid")
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                if nh then pcall(function() cam.CameraSubject = nh end) end
            end
        end
    end)
    invisState.Original = nil
    invisState.Invisible = false
    invisState.Busy = false
    if wasInvis then
        print("[PERMABAN] инвиз: " .. tostring(reason))
    end
end

-- мягкий выход из инвиза: тоггл гаснет + invisRestore
local function invisGracefulExit(reason)
    if not invisState.Enabled then return end
    invisState.Enabled = false
    if invisUIOff then pcall(invisUIOff, false) end
    pcall(invisRestore, reason)
end

-- парковка тела: короткий телепорт вниз + анкор. Пол ищем рейкастом —
-- паркуемся ПОД ним, а не в воздухе (если включить инвиз в прыжке).
-- Такие телепорты анти-телепорт не флажит — проверено в v2.25–v2.29
local function parkOriginal(char, fromCF)
    local ohrp = char:FindFirstChild("HumanoidRootPart")
    if not ohrp then return end
    local parkY = fromCF.Y - INVIS_PARK_DEPTH
    pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local res = workspace:Raycast(fromCF.Position, Vector3.new(0, -200, 0), params)
        if res then parkY = res.Position.Y - INVIS_PARK_DEPTH end
    end)
    invisState.ParkY = parkY
    ohrp.CFrame = CFrame.new(fromCF.X, parkY, fromCF.Z)
    ohrp.AssemblyLinearVelocity = Vector3.zero
    ohrp.AssemblyAngularVelocity = Vector3.zero
    ohrp.Anchored = true
end

local function applyInvis(state)
    if not clientAlive() then return end
    -- поколение: каждый вызов инкрементирует; отложенный выключатель
    -- сработает только если его поколение ещё актуально
    invisState.Gen = (invisState.Gen or 0) + 1
    local myGen = invisState.Gen

    if state then
        -- ── ВКЛ: клон играет за нас, оригинал паркуется под полом ──
        if invisState.Busy or invisState.Invisible then return end
        local char = LocalPlayer.Character
        if not char or not char.Parent then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        -- мусор от прошлого недо-цикла подметаем перед стартом
        if invisState.Original then
            invisCleanup()
        end
        invisState.Busy = true
        local okAll, err = pcall(function()
            local alpha = math.clamp(tonumber(invisState.Ghost) or 0.65, 0.05, 0.99)
            local cam = workspace.CurrentCamera
            local camCF = cam and cam.CFrame
            char.Archivable = true
            local clone = char:Clone()
            for _, v in ipairs(clone:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Transparency = (v.Name == "HumanoidRootPart") and 1 or alpha
                elseif v:IsA("Decal") then
                    v.Transparency = 1
                end
            end
            pcall(function() clone.Name = "" end)   -- как в iY: пустое имя
            local CF_1 = hrp.CFrame
            local chum = clone:FindFirstChildOfClass("Humanoid")
            -- состояние пишем ДО назначения Character: CharacterAdded
            -- стреляет синхронно с присвоением — хэндлер обязан уже видеть
            -- Clone и не трогать клона (баг «пропадания» v2.34–v2.35)
            invisState.Original = char
            invisState.Clone = clone
            if cam then cam.CameraType = Enum.CameraType.Scriptable end
            -- 1) оригинал паркуется под пол: короткий телепорт реплицируется
            --    — для сервера и игроков мы исчезли с карты
            parkOriginal(char, CF_1)
            task.wait()   -- кадр на переезд
            -- тоггл сорвали/респавн случился, пока ехали — тихий откат
            if not invisState.Enabled or LocalPlayer.Character ~= char then
                hrp.CFrame = CF_1
                hrp.Anchored = false
                if cam then
                    cam.CameraType = Enum.CameraType.Custom
                    pcall(function() cam.CameraSubject = hum end)
                    if camCF then pcall(function() cam.CFrame = camCF end) end
                end
                invisState.Original = nil
                invisState.Clone = nil
                return
            end
            -- 2) клон занимает место и становится «нами»
            clone.Parent = workspace
            local chrp = clone:FindFirstChild("HumanoidRootPart")
            if chrp then chrp.CFrame = CF_1 end
            LocalPlayer.Character = clone
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                if chum then pcall(function() cam.CameraSubject = chum end) end
                if camCF then pcall(function() cam.CFrame = camCF end) end
            end
            restartAnimate(clone)
            invisState.Invisible = true
            -- смерть клона → мягкий выход (в iY это Respawn())
            if chum then
                invisState.DiedConn = chum.Died:Connect(function()
                    pcall(invisGracefulExit, "клон умер")
                end)
            end
        end)
        invisState.Busy = false
        if not okAll then
            print("[PERMABAN] инвиз: не включился (" .. tostring(err) .. ")")
            invisState.Enabled = false
            if invisUIOff then pcall(invisUIOff, false) end
            -- возврат в своё тело, а не «остаться без тела»
            pcall(invisRestore, "ошибка включения — возврат в тело")
        end
    else
        -- ── ВЫКЛ: единая процедура возврата ──
        invisRestore("выключено — возврат туда, куда дошёл")
    end
end

local function ghostRebuild()
    -- слайдер Self alpha: живая смена прозрачности клона, без переезда
    local clone = invisState.Clone
    if not (invisState.Invisible and clone and clone.Parent) then return end
    local alpha = math.clamp(tonumber(invisState.Ghost) or 0.65, 0.05, 0.99)
    for _, v in ipairs(clone:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = (v.Name == "HumanoidRootPart") and 1 or alpha
        elseif v:IsA("Decal") then
            v.Transparency = 1
        end
    end
end

-- watchdog клона: провалился под FallenPartsDestroyHeight — мягкий выход
-- (в iY это invisFix на Stepped)
RunService.Heartbeat:Connect(function()
    if not (invisState.Invisible and clientAlive()) then return end
    local clone = invisState.Clone
    if not clone or not clone.Parent then return end
    local chrp = clone:FindFirstChild("HumanoidRootPart")
    if not chrp then return end
    local okF, fdh = pcall(function() return workspace.FallenPartsDestroyHeight end)
    if okF and type(fdh) == "number" and chrp.Position.Y <= fdh then
        pcall(invisGracefulExit, "клон провалился под карту")
    end
end)

-- гардиан: раз в ~0.1с ЧИНИТ инвиз вместо пересборки. В v2.34–v2.35 этот
-- цикл при любом расхождении УНИЧТОЖАЛ клона и пересобирал инвиз —
-- второй источник «пропадания». Теперь:
--  • сервер вернул Character на оригинала (перезапись свойства) — клон
--    жив: пере-усыновляем клон, камеру на него;
--  • сервер дал ДРУГОЕ тело (респавн) — не воюем: мягкий выход;
--  • сервер вытащил тело из парковки (раунд-телепорт) — прячем заново;
--  • игровой скрипт сбросил CameraSubject — возвращаем на клона.
task.spawn(function()
    local t0 = os.clock()
    while true do
        RunService.RenderStepped:Wait()
        if os.clock() - t0 >= 0.1 then
            t0 = os.clock()
            if invisState.Enabled and clientAlive()
                and invisState.Invisible and not invisState.Busy then
                local clone = invisState.Clone
                if clone and clone.Parent then
                    if LocalPlayer.Character ~= clone then
                        if LocalPlayer.Character == invisState.Original then
                            -- свойство перезаписали тем же телом — забираем клон обратно
                            LocalPlayer.Character = clone
                            restartAnimate(clone)
                        else
                            -- сервер дал новое тело — мягкий выход, без циклов
                            pcall(invisGracefulExit, "сервер дал новое тело")
                        end
                    end
                else
                    pcall(invisGracefulExit, "клон уничтожен извне")
                end
                if invisState.Invisible and not invisState.Busy then
                    -- камера должна смотреть на клона
                    local clone2 = invisState.Clone
                    local cam = workspace.CurrentCamera
                    local chum = clone2 and clone2:FindFirstChildOfClass("Humanoid")
                    if cam and chum and cam.CameraSubject ~= chum then
                        pcall(function()
                            cam.CameraType = Enum.CameraType.Custom
                            cam.CameraSubject = chum
                        end)
                    end
                    -- тело вытащили из парковки? прячем снова
                    local original = invisState.Original
                    if original and original.Parent then
                        local ohrp = original:FindFirstChild("HumanoidRootPart")
                        if ohrp then
                            if not ohrp.Anchored then ohrp.Anchored = true end
                            local parkY = invisState.ParkY
                            if parkY and ohrp.Position.Y > parkY + 2 then
                                pcall(function()
                                    ohrp.CFrame = CFrame.new(ohrp.Position.X, parkY, ohrp.Position.Z)
                                    ohrp.AssemblyLinearVelocity = Vector3.zero
                                    ohrp.AssemblyAngularVelocity = Vector3.zero
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- CharacterAdded стреляет и от НАШЕГО собственного назначения клона
-- (LocalPlayer.Character = clone), и от настоящего респавна сервера.
-- v2.34–v2.35 не различали эти случаи и через 0.3с уничтожали живого
-- клона — ГЛАВНАЯ причина «пол секунды нормальные, потом я пропадаю».
-- Теперь: свой клон — игнор; настоящее новое тело — мягкий выход
LocalPlayer.CharacterAdded:Connect(function(newChar)
    if newChar == invisState.Clone then return end
    if not invisState.Enabled then return end
    task.spawn(function()
        task.wait(0.3)
        if invisState.Enabled and clientAlive()
            and LocalPlayer.Character == newChar
            and newChar ~= invisState.Clone then
            pcall(invisGracefulExit, "сервер сделал респавн — выход из инвиза")
        end
    end)
end)


-- 3G. VELOCITY DESYNC (вкладка Target, под Hitbox)
-- Подмена AssemblyLinearVelocity/AssemblyAngularVelocity на РОВНО ОДИН кадр
-- с рестором: репликация успевает унести мусорную скорость другим клиентам,
-- их предикт/сайлент по тебе промахивается. Всё через свойства HRP, без
-- хуков; тело не телепортируется и не становится невидимым.
-- ==========================================
local desyncState = { Enabled = false, Mode = "low", Rotate = false, Interval = 0.1, LastFire = 0 }

-- пул для режима random: каждый выстрел десынка берёт новый режим
local DESYNC_RAND_POOL = { "low", "high", "yhigh", "limit", "zero" }

local function desyncVector(mode)
    if mode == "low" then
        return Vector3.new(math.random(-300, 300), math.random(-300, 300), math.random(-300, 300))
    elseif mode == "high" then
        return Vector3.new(math.random(-16384, 16384), math.random(-16384, 16384), math.random(-16384, 16384))
    elseif mode == "yhigh" then
        return Vector3.new(0, 16384, 0)
    elseif mode == "limit" then
        -- 2^31: Roblox переваривает, а чужой предикт на таких числах умирает
        return Vector3.new(
            math.random(-2147483648, 2147483647),
            math.random(-2147483648, 2147483647),
            math.random(-2147483648, 2147483647))
    elseif mode == "zero" then
        return Vector3.new(0, 0, 0)
    else
        return desyncVector(DESYNC_RAND_POOL[math.random(1, #DESYNC_RAND_POOL)])
    end
end

-- десынк скорости: на один кадр подменяем AssemblyLinearVelocity (и угловую,
-- если Rotate) вектором по режиму, следующим кадром откатываем назад.
-- Используется для сбива чужого предикта/сайлента, НЕ делает невидимым.
local function desyncStep()
    if not desyncState.Enabled then return end
    if not clientAlive() then return end
    local now = os.clock()
    if now < desyncSafeUntil then return end
    if now - desyncState.LastFire < desyncState.Interval then return end
    if now - lastHitboxRestore < 0.5 then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if hum.PlatformStand or hum.Seated then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or hrp.Anchored then return end

    desyncState.LastFire = now
    local mode = desyncState.Mode
    if mode == "random" then
        mode = DESYNC_RAND_POOL[math.random(1, #DESYNC_RAND_POOL)]
    end
    local fake = desyncVector(mode)
    local oldLin = hrp.AssemblyLinearVelocity
    local oldAng = hrp.AssemblyAngularVelocity
    local spin = desyncState.Rotate
    pcall(function() hrp.AssemblyLinearVelocity = fake end)
    if spin then pcall(function() hrp.AssemblyAngularVelocity = fake end) end
    -- рестор строго через RenderStepped:Wait() — один кадр подмены.
    -- task.wait(0.1) тут убил бы физику: персонаж завис/улетел
    task.spawn(function()
        RunService.RenderStepped:Wait()
        pcall(function()
            if hrp.Parent then
                hrp.AssemblyLinearVelocity = oldLin
                if spin then hrp.AssemblyAngularVelocity = oldAng end
            end
        end)
    end)
end

RunService.Heartbeat:Connect(desyncStep)


-- ==========================================
-- 3H. FLING — раскрутка себя о цель (вкладка Fling)
-- Клиент НЕ может двинуть чужого персонажа напрямую (нет network ownership),
-- но МОЖЕТ раскрутить свой: жмём огромную угловую скорость на свой HRP и
-- прижимаемся к цели — при контакте сервер разруливает столкновение, и
-- улетает УЖЕ цель. Касания обязательны: в инвизе флинг недоступен
-- (тебя нет на карте). Позиция записывается ДО старта —
-- после флинга возвращаемся ровно в неё (v2.29)
-- ==========================================
local flingState = { Busy = false }

local function flingPlayer(pl)
    if flingState.Busy then return end
    if not clientAlive() or pl == LocalPlayer then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not hum or hum.Health <= 0 then return end
    if invisState.Enabled then return end   -- в инвизе касаний нет — флинг бессмыслен
    if hrp.Anchored then return end
    local tchar = pl.Character
    local thrp = tchar and tchar:FindFirstChild("HumanoidRootPart")
    if not thrp then return end
    flingState.Busy = true
    -- v2.29: ЗАПИСЬ ПОЗИЦИИ до флинга — после раскрутки возвращаем ровно в неё
    local savedPos = hrp.Position
    local savedRot = hrp.CFrame.Rotation
    task.spawn(function()
        local t0 = os.clock()
        while os.clock() - t0 < 1.5 and clientAlive() do
            local tc = pl.Character
            local th = tc and tc:FindFirstChild("HumanoidRootPart")
            local mc = LocalPlayer.Character
            local mh = mc and mc:FindFirstChild("HumanoidRootPart")
            if th and mh then
                mh.CFrame = th.CFrame * CFrame.new(math.random() * 2 - 1, 0.5, math.random() * 2 - 1)
                pcall(function()
                    mh.AssemblyAngularVelocity = Vector3.new(1e6, 1e6, 1e6)
                    mh.AssemblyLinearVelocity = Vector3.new(0, 20, 0)
                end)
            end
            RunService.Heartbeat:Wait()
        end
        -- возврат в ЗАПИСАННУЮ позицию: пиним CFrame несколько кадров подряд
        -- и глушим скорость каждый кадр — пока не уляжется висящая физика
        pcall(function()
            if clientAlive() then
                local mc = LocalPlayer.Character
                local mh = mc and mc:FindFirstChild("HumanoidRootPart")
                if mh then
                    local target = CFrame.new(savedPos) * savedRot
                    for _ = 1, 15 do
                        if not mh.Parent then break end
                        mh.AssemblyAngularVelocity = Vector3.zero
                        mh.AssemblyLinearVelocity = Vector3.zero
                        mh.CFrame = target
                        RunService.Heartbeat:Wait()
                    end
                    if mh.Parent then
                        mh.AssemblyAngularVelocity = Vector3.zero
                        mh.AssemblyLinearVelocity = Vector3.zero
                        mh.CFrame = target
                    end
                end
            end
        end)
        flingState.Busy = false
    end)
end

