-- WEAPON SERVICE (дамп шитаро 3487–3533): направление выстрела пистолетом
-- И броска ножа игра берёт из require(ClientServices.WeaponService) —
-- GetMouseTargetCFrame / GetTargetPosition. Подменяем их на кеш-точку цели:
-- пистолет и нож летят точно в голову без движения камеры (и сквозь стены —
-- как шитаровский silent). Внутри хука ТОЛЬКО чтение кеш-точек, никаких
-- Roblox API — иначе рекурсия namecall'ов убьёт ввод, как раньше
local wsHookInstalled = false
local function installWeaponHook()
    if wsHookInstalled then return end
    local rs = game:GetService("ReplicatedStorage")
    local cs = rs:FindFirstChild("ClientServices")
    if not cs then return end
    local wsm = cs:FindFirstChild("WeaponService")
    if not wsm then return end
    local ok, m = pcall(require, wsm)
    if not ok or type(m) ~= "table" then return end
    -- ФИКС ЗУМА: раньше отдавали CFrame прямо в точку цели — MM2 тянет
    -- камеру (gun-zoom) к точке прицела, и на дальней цели камера
    -- "приближалась" при сайленте. Теперь направление — в цель, а ДИСТАНЦИЯ
    -- точки — как у оригинального mouse-hit: камера стоит как в ваниле,
    -- выстрел/бросок летят по направлению (FireServer-хук доводит точку)
    local function wsResolve(origCF)
        -- гейт как у namecall-хука: Auto Shoot сам только СТРЕЛЯЕТ,
        -- ручные выстрелы перенаправляет лишь Sheriff-аим или форс
        if not (aimState.Enabled or aimState.ForceShot) then return nil end
        local pt, o
        if silentPoint then
            pt, o = silentPoint, silentOrigin or silentPoint
        else
            return nil
        end
        if (pt - o).Magnitude < 0.01 then return nil end
        local dir = (pt - o).Unit
        if typeof(origCF) == "CFrame" then
            local cam = workspace.CurrentCamera
            local d = cam and (origCF.Position - cam.CFrame.Position).Magnitude or 0
            if d > 1 then
                local pos = o + dir * d
                return CFrame.lookAt(pos, pos + dir)
            end
        end
        return CFrame.lookAt(o, pt)
    end
    pcall(function()
        if setreadonly then setreadonly(m, false) end
        local orig_mouse = m.GetMouseTargetCFrame
        if type(orig_mouse) == "function" then
            m.GetMouseTargetCFrame = function(self, ...)
                local okO, ocf = pcall(orig_mouse, self, ...)
                if not okO then
                    -- оригинал упал: отдаём честную точку на цели (старое поведение)
                    local got, cf = pcall(wsResolve, nil)
                    if got and cf then return cf end
                    error(ocf)
                end
                local got, cf = pcall(wsResolve, ocf)
                if got and cf then return cf end
                return ocf
            end
        end
        local orig_screen = m.GetTargetPosition
        if type(orig_screen) == "function" then
            m.GetTargetPosition = function(self, ...)
                local okO, oval = pcall(orig_screen, self, ...)
                if not okO then
                    local got, cf = pcall(wsResolve, nil)
                    if got and cf then return cf.Position end
                    error(oval)
                end
                local got, cf = pcall(wsResolve, typeof(oval) == "Vector3" and CFrame.new(oval) or nil)
                if got and cf then return cf.Position end
                return oval
            end
        end
    end)
    wsHookInstalled = true
    print("[PERMABAN] WeaponService hook: OK")
end
task.spawn(function()
    for _ = 1, 30 do
        installWeaponHook()
        if wsHookInstalled then break end
        task.wait(1)
    end
end)

-- redirectArgs удалён: был нужен только броску ножа, нож-аима больше нет

local hookOk, hookErr = pcall(function()
    local oldNamecall
    -- безопасный вызов оригинала: inHook сбрасывается ВСЕГДА, даже если
    -- игра сама кинет ошибку. Раньше при ошибке внутри перенаправленного
    -- вызова inHook залипал в true — хук навсегда уходил в bypass и
    -- сайлент "умирал" до перезахода (симптомы: не стреляет / не кидает)
    local function callOrig(...)
        inHook = true
        local packed = table.pack(pcall(oldNamecall, ...))
        inHook = false
        if not packed[1] then error(packed[2]) end
        return unpack(packed, 2, packed.n)
    end
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        -- защита от повторного входа — на всякий случай; bypass наших
        -- автозалпов: свой прямой FireServer хук не переписывает
        if inHook or rayBypass or autoFire.bypass then return oldNamecall(self, ...) end
        -- аим ИЛИ форс шот: каждый со своим флагом — форс шот самостоятельный
        if aimState.Enabled or aimState.ForceShot then
            local method = getnamecallmethod()
            if method == "Raycast" and aimState.Enabled and aimState.Mode == "Silent" and silentPoint and self == workspace then
                local args = { ... }
                local origin, dir = args[1], args[2]
                if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" and dir.Magnitude > 0 then
                    args[2] = (silentPoint - origin).Unit * dir.Magnitude
                    return callOrig(self, unpack(args))
                end
            elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList"
                or method == "FindPartOnRayWithWhitelist")
                and aimState.Enabled and aimState.Mode == "Silent" and silentPoint and self == workspace then
                local args = { ... }
                local ray = args[1]
                if ray and ray.Direction.Magnitude > 0 then
                    args[1] = Ray.new(ray.Origin, (silentPoint - ray.Origin).Unit * ray.Direction.Magnitude)
                    return callOrig(self, unpack(args))
                end
            elseif method == "FireServer" then
                -- self.Name — чтение свойства, не namecall, рекурсии не будет
                local n = self and self.Name
                if type(n) == "string" then
                    local nl = n:lower()
                    -- пистолет (дамп шитаро 3576–3580): gun.Shoot:FireServer(start_cf, aim_cf).
                    -- Подменяем ТОЛЬКО aim — последний CFrame/Vector3 в списке;
                    -- start не трогаем: раньше redirectArgs перезаписывал ОБА аргумента,
                    -- сервер видел старт из головы цели и молча отбрасывал выстрел —
                    -- потому сайлент на пистолете и не работал
                    if (aimState.Enabled or aimState.ForceShot) and (silentPoint or forceOriginCF)
                        and (nl == "shoot" or nl:find("shoot", 1, true)) then
                        -- любой перехваченный выстрел откладывает десынк на 0.15с:
                        -- подмена скорости не должна совпасть с репликацией выстрела
                        desyncSafeUntil = os.clock() + 0.15
                        local args = { ... }
                        local changed = false
                        local finalAim = nil   -- фактическая точка полёта — для трейсера
                        if aimState.ForceShot and forceOriginCF and forceAimCF then
                            -- PUSH ORIGIN (шитаро 3341 / KITI 9488): аттач
                            -- GunRaycastAttachment на миг встаёт в начало
                            -- коридора — сервер видит старт выстрела И в
                            -- аргументах Shoot, И на аттаче. Возврат — в
                            -- тот же кадр (task.defer внутри pushOrigin)
                            pcall(pushOrigin, forceOriginCF)
                            -- FORCESHOT: gun.Shoot:FireServer(start_cf, aim_cf) —
                            -- старт это ПЕРВЫЙ CFrame (коридор), прицел — последний.
                            -- ВМЕСТЕ с аимом: прицел — упреждённая голова, но ТОЛЬКО
                            -- если она лежит на линии коридора (скалярное произведение
                            -- вручную: никаких namecall-вызовов внутри хука), иначе —
                            -- конец коридора как в чистом шитаро: серверный рейкаст
                            -- должен воткнуться в цель, а не в стену рядом с ней
                            local aimCF = forceAimCF
                            if silentPoint then
                                local from = forceOriginCF.Position
                                local dCor = forceAimCF.Position - from
                                local dAim = silentPoint - from
                                local mc, ma = dCor.Magnitude, dAim.Magnitude
                                if mc > 0.05 and ma > 0.05
                                    and (dCor.X * dAim.X + dCor.Y * dAim.Y + dCor.Z * dAim.Z) / (mc * ma) > 0.98 then
                                    aimCF = CFrame.new(silentPoint)
                                end
                            end
                            for i = 1, #args do
