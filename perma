    if autoFire.lastShot > 0 then
        local g = nowc - autoFire.lastShot
        if g > 0.02 and (not autoFire.gapSeen or g < autoFire.gap) then
            autoFire.gap = g
            autoFire.gapSeen = true
        end
    end
    autoFire.lastShot = nowc
end

