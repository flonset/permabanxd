-- имя тулки → роль. С v2.35 используется ТОЛЬКО для тега СВОЕГО ножа
-- (хитбокс-экспандер ниже) и ничего не говорит о чужих ролях
local WEAPON_ROLE_MAP = {
    Knife = "Murderer",
    Gun = "Sheriff",
    Revolver = "Sheriff"   -- алиас пистолета в старых версиях MM2
}
local DROPPED_WEAPON_NAMES = {"Gun", "Knife"}   -- модели оружия на полу

-- дропнутый шерифом пистолет в MM2 — это объект с именем GunDrop
-- прямо в workspace (подтверждено скриптами Bacon Hub / retpirato /
-- Moondiety — все ищут именно workspace.GunDrop). Старый сканер
-- искал только Gun/Knife и GunDrop никогда не находил

-- дропнутое оружие лежит Tool’ом или моделью в workspace, в папке
-- уровнем глубже, либо это GunDrop где угодно по дереву
local function scanDroppedWeapons()
    local found = {}
    -- GunDrop в первую очередь: он может лежать на любом уровне вложенности
    local gd = workspace:FindFirstChild("GunDrop", true)
    if gd then table.insert(found, gd) end
    for _, obj in ipairs(workspace:GetChildren()) do
        if (obj:IsA("Tool") or obj:IsA("Model")) and table.find(DROPPED_WEAPON_NAMES, obj.Name) then
            table.insert(found, obj)
        elseif obj:IsA("Folder") then
            for _, sub in ipairs(obj:GetChildren()) do
                if (sub:IsA("Tool") or sub:IsA("Model")) and table.find(DROPPED_WEAPON_NAMES, sub.Name) then
                    table.insert(found, sub)
                end
            end
        end
    end
    return found
end

-- ==========================================
-- СЕРВЕРНЫЕ РОЛИ (v2.35 — по хедшоту, «старые проверки удалить»).
-- Роли приходят ИСКЛЮЧИТЕЛЬНО из ремоута GetPlayerData (Remotes/Extras):
-- сервер отдаёт их ДО репликации оружия; проверки поверх — мусор.
-- История доводки: v2.32 починил GetService, но
-- оставались дыры, каждая из которых в одиночку убивала ветку:
--  ① InvokeServer — yield-вызов: если сервер не отвечает (ремоут ждёт
--    аргументы/репликацию), поток опроса ВИСНЕТ в pcall навсегда —
--    ни ошибок, ни дампов, полная тишина. Лечится таймаутом + task.cancel.
--  ② Ответ мог иметь любую форму — старый парсер знал две; всё прочее
--    молча давало 0 записей.
--  ③ table.clear(serverRoles) каждый тик: один сбойный/пустой ответ —
--    и роли стёрты, дальше снова «работает только по оружию».
--  ④ Дампы формы были одноразовыми: первый ответ (лобби, пусто)
--    печатался и больше диагностики не было никогда.
-- Теперь: вызов с таймаутом 3с и task.cancel, автоподбор аргументов
-- (пусто / LocalPlayer / UserId) с запоминанием рабочего, рекурсивный
-- парсер глубины 4 (ключ-ник/Player/UserId/DisplayName, поле Name внутри
-- значения, роль как ключ Murderer={...}, булевы флаги Murderer=true,
-- русские и английские алиасы + фаззи-подстроки), слияние вместо очистки
-- (полный ответ ≥2 игроков — атомарная замена, одиночная запись — влив,
-- 12 пустых ответов подряд = конец раунда — сброс), повторный дамп формы
-- каждые 30с, пока роли не спарсились хоть раз, лог «сервер: ник → роль»
-- при каждом изменении, плюс скан Value-объектов у игроков вторым
-- источником.
-- ==========================================
local scriptStartT = tick()
local serverRoles = {}          -- [ник] = "Murderer"/"Sheriff"/"Innocent"/"Hero"
local rolesEverParsed = false   -- хоть раз получили роли с сервера
local shapeDumpT = 0            -- повторный дамп формы (раз в 30с до успеха)
local probeWarnT = 0            -- варны «ремоут не найден» не чаще раза в 10с
local emptyStreak = 0           -- пустых ответов подряд (сброс = конец раунда)
local lastLoggedRoles = {}      -- [ник] = последняя залогированная роль

-- алиасы ролей: сервер может отдавать в другом регистре/склонении,
-- а roleOf сравнивает напрямую с ключами chamsState.Roles
local ROLE_ALIASES = {
    murderer = "Murderer", murder = "Murderer", murd = "Murderer", killer = "Murderer",
    sheriff  = "Sheriff",  sherif = "Sheriff",  seriff = "Sheriff", detective = "Sheriff", det = "Sheriff",
    innocent = "Innocent", inno   = "Innocent", civilian = "Innocent", civil = "Innocent",
    bystander = "Innocent", survivor = "Innocent", crewmate = "Innocent",
    hero     = "Hero"
}
-- фаззи: «ROLE_Murderer», «MurdererTeam», «Убийца» и т.п. — по подстроке
local ROLE_FUZZ = {
    { "murder", "Murderer" }, { "killer", "Murderer" }, { "убийц", "Murderer" },
    { "маньяк", "Murderer" }, { "килл", "Murderer" },
    { "sher", "Sheriff" }, { "detect", "Sheriff" }, { "шер", "Sheriff" },
    { "полиц", "Sheriff" }, { "детект", "Sheriff" },
    { "hero", "Hero" }, { "герой", "Hero" }, { "геро", "Hero" },
    { "inno", "Innocent" }, { "civil", "Innocent" }, { "bystand", "Innocent" },
    { "survivor", "Innocent" }, { "невин", "Innocent" }, { "мирн", "Innocent" },
    { "жител", "Innocent" }
}
local function normRole(r)
    if type(r) ~= "string" then return nil end
    local s = r:lower():gsub("%s+", "")
    local a = ROLE_ALIASES[s]
    if a then return a end
    for _, f in ipairs(ROLE_FUZZ) do
        if s:find(f[1], 1, true) then return f[2] end
    end
    return nil
end

-- v2.35: фильтр Dead/Killed УДАЛЕН по совету хедшота («старые проверки
-- удалить»). Главный подозреваемый всего бага: если Killed в ответе — это
-- ЧИСЛО УБИЙСТВ ЗА ВСЁ ВРЕМЯ (стат), фильтр «Killed>0 → мёртв» молча
-- выкидывал из ролей всех опытных игроков, и чамсы жили только по оружию.
-- Теперь серверные роли читаются у ВСЕХ. Мёртвым подсветка и так не
-- вешается: у мёртвых нет живого персонажа в цикле чамсов

-- безопасный дамп формы ответа: typeof для ключей/значений, глубина 2,
-- максимум 24 записи — по нему в консоли (F9) виден реальный формат
local function dumpShape(data)
    local function val(v, depth)
        local t = typeof(v)
        if t == "string" then return string.format("%q", v:sub(1, 60)) end
        if t == "Instance" then return t .. "(" .. v.Name .. ")" end
        if t == "table" then
            if depth >= 2 then return "table" end
            local inner, n = {}, 0
            for k2, v2 in pairs(v) do
                n = n + 1
                if n > 8 then table.insert(inner, "...") break end
                table.insert(inner, tostring(k2) .. " = " .. val(v2, depth + 1))
            end
            return "{" .. table.concat(inner, ", ") .. "}"
        end
        return t .. "(" .. tostring(v) .. ")"
    end
    local parts, n = {}, 0
    for k, v in pairs(data) do
        n = n + 1
        if n > 24 then table.insert(parts, "...") break end
        table.insert(parts, val(k, 1) .. " = " .. val(v, 1))
    end
    return table.concat(parts, ", ")
end

-- ремоут: ровно по слитому пути (Remotes/Extras/GetPlayerData, подтверждено
-- референсом хедшота), с WaitForChild-фолбэком если Remotes ещё не приехал,
-- потом глубокий поиск по всему ReplicatedStorage
local function findDataRemote()
    local okR, remote = pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("Remotes")
            or ReplicatedStorage:WaitForChild("Remotes", 5)
        local ex = rem and rem:FindFirstChild("Extras")
        return ex and ex:FindFirstChild("GetPlayerData") or nil
    end)
    if okR and typeof(remote) == "Instance" then
        return remote, "Remotes/Extras/GetPlayerData"
    end
    local okD, deep = pcall(function()
        return ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    end)
    if okD and typeof(deep) == "Instance" then
        return deep, deep:GetFullName()
    end
    return nil, nil
end

-- стили вызова ремоута: пустой вызов, с игроком, с UserId — серверные
-- RemoteFunction бывают любые; рабочий стиль запоминается ПЕРВОМУ ремоуту
local REMOTE_ARG_STYLES = {
    function(r) return r:InvokeServer() end,
    function(r) return r:InvokeServer(LocalPlayer) end,
    function(r) return r:InvokeServer(LocalPlayer.UserId) end,
}
local remoteStyles = setmetatable({}, { __mode = "k" })   -- [remote] = индекс стиля
local remoteFails = setmetatable({}, { __mode = "k" })    -- [remote] = неудач подряд

-- InvokeServer — yield-функция: если сервер не отвечает, поток висит вечно.
-- Крутим вызов в отдельном потоке с таймаутом: не ответил за 3с —
-- task.cancel и живём дальше. Вечный yield внутри pcall был главной
-- подозреваемой «тихой смерти» всего опроса ролей (v2.34)
local function invokeRemote(remote)
    local function attempt(styleIdx)
        local done, ok, data = false, false, nil
        local th = task.spawn(function()
            ok, data = pcall(REMOTE_ARG_STYLES[styleIdx], remote)
            done = true
        end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < 3 do
            task.wait(0.1)
        end
        if not done then
            pcall(task.cancel, th)
            return false, nil
        end
        return ok, data
    end

    local known = remoteStyles[remote]
    if known then
        local ok, data = attempt(known)
        if ok and type(data) == "table" then
            remoteFails[remote] = 0
            return data
        end
        remoteFails[remote] = (remoteFails[remote] or 0) + 1
        if remoteFails[remote] < 5 then return nil end
        remoteStyles[remote] = nil   -- стиль перестал работать — переищем
    end

    for idx = 1, #REMOTE_ARG_STYLES do
        local ok, data = attempt(idx)
        if ok and type(data) == "table" then
            remoteStyles[remote] = idx
            remoteFails[remote] = 0
            return data
        end
    end
    return nil
end

-- запасные ремоуты: только RemoteFunction с именем Get*Data/Get*Player/
-- Get*Role/Get*Game — чтение по конвенции, максимум 3 штуки
local candidateRemotes, candidateT = nil, 0
local candidateProbedT = {}
local function collectRemoteCandidates()
    if candidateRemotes and tick() - candidateT < 10 then return candidateRemotes end
    candidateT = tick()
    candidateRemotes = {}
    pcall(function()
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("RemoteFunction") then
                local ln = d.Name:lower()
                if ln:sub(1, 3) == "get"
                    and (ln:find("data") or ln:find("role") or ln:find("player") or ln:find("game")) then
                    table.insert(candidateRemotes, d)
                    if #candidateRemotes >= 3 then break end
                end
            end
        end
    end)
    return candidateRemotes
end

-- ключ/поле имени игрока → ник: строка, Player, UserId (число и строка),
-- DisplayName. Случайные ключи («Coins», «RoundTime») игроками не считаем
local function resolvePlayerName(k)
    if type(k) == "string" then
        if Players:FindFirstChild(k) then return k end
        if k:match("^%d+$") then
            local ok, pl = pcall(Players.GetPlayerByUserId, Players, tonumber(k))
            if ok and pl then return pl.Name end
        end
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.DisplayName == k then return pl.Name end
        end
        return nil
    end
    local t = typeof(k)
    if t == "Instance" and k:IsA("Player") then return k.Name end
    if t == "number" then
        local ok, pl = pcall(Players.GetPlayerByUserId, Players, k)
        if ok and pl then return pl.Name end
    end
    return nil
end

local function playerExists(name)
    if type(name) ~= "string" or name == "" then return false end
    return Players:FindFirstChild(name) ~= nil
end

-- внутри таблицы-игрока ищем поле имени (Name/Username/Player/…)
local NAME_FIELDS = { "Name", "name", "Username", "username", "Player", "player",
    "PlayerName", "playerName", "Nick", "nick", "DisplayName", "Plr", "plr" }
local function nameFromValue(v)
    if type(v) ~= "table" then return nil end
    for _, f in ipairs(NAME_FIELDS) do
        local nv = v[f]
        if type(nv) == "string" and playerExists(nv) then return nv end
        if typeof(nv) == "Instance" and nv:IsA("Player") then return nv.Name end
    end
    return nil
end

-- поля, в которых может лежать роль (плюс булевы флаги и вложенные таблицы)
local ROLE_FIELDS = { Role = true, role = true, PlayerRole = true, playerRole = true,
    RoleName = true, roleName = true, Team = true, team = true, Job = true, job = true,
    Kind = true, kind = true, Mode = true, mode = true, Type = true, type = true,
    Rank = true, rank = true, State = true, state = true, GroupRole = true }
local function findRoleIn(v, depth)
    local t = type(v)
    if t == "string" then return normRole(v) end
    if t ~= "table" or depth > 3 then return nil end
    for f in pairs(ROLE_FIELDS) do
        local r = normRole(v[f])
        if r then return r end
    end
    for k, val in pairs(v) do
        if val == true and type(k) == "string" then
            local r = normRole(k)
            if r then return r end
        end
    end
    for _, val in pairs(v) do
        if type(val) == "table" then
            local r = findRoleIn(val, depth + 1)
            if r then return r end
        end
    end
    return nil
end

-- рекурсивный парсер ЛЮБОЙ формы ответа, глубина 4:
--  (а) ключ идентифицирует игрока, значение содержит роль (строка/таблица)
--  (б) значение содержит поле имени игрока и роль
--  (в) роль — ключ: Murderer = { "Alice", PlayerB, {Name="C"} }
local function deepParseRoles(root)
    if type(root) ~= "table" then return {} end
    local found = {}
    local seen = {}
    local function walk(v, depth)
        if type(v) ~= "table" or depth > 4 or seen[v] then return end
        seen[v] = true
        for k, val in pairs(v) do
            -- (а) ключ = игрок
            local n = resolvePlayerName(k)
            if n then
                local r = findRoleIn(val, 0)
                if r then
                    found[n] = r
                end
            end
            -- (в) роль = ключ
            if type(k) == "string" then
                local rk = normRole(k)
                if rk then
                    if type(val) == "string" then
                        if playerExists(val) then found[val] = rk end
                    elseif typeof(val) == "Instance" and val:IsA("Player") then
                        found[val.Name] = rk
                    elseif type(val) == "table" then
                        for _, el in pairs(val) do
                            if type(el) == "string" and playerExists(el) then
                                found[el] = rk
                            elseif typeof(el) == "Instance" and el:IsA("Player") then
                                found[el.Name] = rk
                            elseif type(el) == "table" then
                                local nn = nameFromValue(el)
                                if nn then found[nn] = rk end
                            end
                        end
                    end
                end
            end
            -- (б) значение = таблица с полем имени
            if type(val) == "table" then
                local n2 = nameFromValue(val)
                if n2 then
                    local r = findRoleIn(val, 0)
                    if r then
                        found[n2] = r
                    end
                end
                walk(val, depth + 1)
            end
        end
    end
    walk(root, 0)
    -- плоский ответ про самого себя: {Role="Sheriff", Dead=false, ...}
    if next(found) == nil then
        local fr = findRoleIn(root, 0)
        if fr then found[LocalPlayer.Name] = fr end
    end
    return found
end

-- применяем спарсенное к МАСТЕР-таблице. НЕ table.clear каждый тик:
-- полный ответ (≥2 игроков) — атомарная замена (старые роли прошлого
-- раунда не висят), одиночная — влив (частичные ответы не теряют остальных),
-- пустой — держим старое; 12 пустых ПОДРЯД = сервер перестал отдавать
-- (конец раунда) — сброс. Ушедшие с сервера игроки вычищаются всегда
local function applyParsed(found)
    local n = 0
    for _ in pairs(found) do n = n + 1 end
    if n >= 2 then
        table.clear(serverRoles)
        emptyStreak = 0
    elseif n == 1 then
        emptyStreak = 0
    else
        emptyStreak = emptyStreak + 1
        if emptyStreak >= 12 and next(serverRoles) then
            table.clear(serverRoles)
            table.clear(lastLoggedRoles)
            print("[PERMABAN] роли сброшены: сервер перестал отдавать данные (раунд кончился?)")
        end
    end
    for name, role in pairs(found) do
        serverRoles[name] = role
    end
    for name in pairs(serverRoles) do
        if not Players:FindFirstChild(name) then
            serverRoles[name] = nil
            lastLoggedRoles[name] = nil
        end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        local r = serverRoles[pl.Name]
        if r and lastLoggedRoles[pl.Name] ~= r then
            lastLoggedRoles[pl.Name] = r
            print("[PERMABAN] сервер: " .. pl.Name .. " → " .. r)
        end
    end
    if n > 0 then rolesEverParsed = true end
end

-- источник 2: Value-объекты у игроков (PlayerData/Data/Stats/… —
-- StringValue с ролью в значении или имени, BoolValue Murderer=true)
local ROLE_VALUE_FOLDERS = { "PlayerData", "Data", "Stats", "Info", "RoleData",
    "RoundData", "leaderstats" }
local function rolesFromValues()
    local found = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        pcall(function()
            local function look(f)
                for _, v in ipairs(f:GetDescendants()) do
                    if v:IsA("StringValue") then
                        local byValue = normRole(v.Value)
                        local byName = normRole(v.Name)
                        local ln = v.Name:lower()
                        if byValue and (ln:find("role") or ln:find("team")
                            or ln:find("job") or byName) then
                            found[pl.Name] = byValue
                        elseif byName then
                            found[pl.Name] = byName
                        end
                    elseif v:IsA("BoolValue") then
                        local byName = normRole(v.Name)
                        if byName and v.Value == true then
                            found[pl.Name] = byName
                        end
                    end
                end
            end
            for _, fn in ipairs(ROLE_VALUE_FOLDERS) do
                local f = pl:FindFirstChild(fn)
                if f then look(f) end
            end
            for _, v in ipairs(pl:GetChildren()) do
                if v:IsA("StringValue") then
                    local r = normRole(v.Value) or normRole(v.Name)
                    if r then found[pl.Name] = r end
                end
            end
        end)
    end
    return found
end

-- пробуем запасные ремоуты: если основной не найден ЛИБО пока роли
-- ни разу не спарсились и прошло >45с от старта
local function probeCandidates()
    if rolesEverParsed then return end
    if tick() - scriptStartT < 45 then return end
    for _, cand in ipairs(collectRemoteCandidates()) do
        local cpath = cand:GetFullName()
        if not candidateProbedT[cpath] or tick() - candidateProbedT[cpath] > 30 then
            candidateProbedT[cpath] = tick()
            local cdata = invokeRemote(cand)
            if type(cdata) == "table" then
                print("[PERMABAN] roles probe: запасной ремоут " .. cpath
                    .. " ответил: " .. dumpShape(cdata))
                local cfound = deepParseRoles(cdata)
                local cn = 0
                for _ in pairs(cfound) do cn = cn + 1 end
                if cn > 0 then
                    rolesEverParsed = true
                    print("[PERMABAN] серверные роли ЗАРАБОТАЛИ через " .. cpath
                        .. ": " .. cn .. " → " .. HttpService:JSONEncode(cfound))
                end
                applyParsed(cfound)
            end
            task.wait(0.2)   -- не долбим ремоут-кандидаты подряд
        end
    end
end

local function updateServerRoles()
    if not clientAlive() then return end
    local remote, path = findDataRemote()
    if not remote then
        if tick() - probeWarnT > 10 then
            probeWarnT = tick()
            -- разовый список кандидатов: вдруг ремоут называется иначе
            local names = {}
            pcall(function()
                for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
                    if d:IsA("RemoteFunction") and d.Name:lower():find("data") then
                        table.insert(names, d:GetFullName())
                        if #names >= 10 then break end
                    end
                end
            end)
            print("[PERMABAN] roles probe: GetPlayerData НЕ найден; кандидаты: "
                .. (#names > 0 and table.concat(names, " | ") or "нет RemoteFunction с 'data'"))
        end
        probeCandidates()
        return
    end

    local data = invokeRemote(remote)
    if type(data) ~= "table" then
        -- валидного ответа НЕТ: роли НЕ трогаем (сбой сети/висящий вызов
        -- не должен стирать то, что уже знаем). Дамп повторяется каждые 30с
        if not rolesEverParsed and tick() - shapeDumpT > 30 then
            shapeDumpT = tick()
            print("[PERMABAN] roles probe: " .. path
                .. " не отвечает таблицей (висит/ошибка/мусор) — повторяю каждые 30с")
        end
        probeCandidates()
        return
    end

    if not rolesEverParsed and tick() - shapeDumpT > 30 then
        shapeDumpT = tick()
        print("[PERMABAN] roles probe: " .. path .. " ответил: " .. dumpShape(data))
    end

    local found = deepParseRoles(data)
    local n = 0
    for _ in pairs(found) do n = n + 1 end
    if n > 0 and not rolesEverParsed then
        rolesEverParsed = true
        print("[PERMABAN] серверные роли ЗАРАБОТАЛИ (" .. path .. "): " .. n
            .. " → " .. HttpService:JSONEncode(found))
    end
    applyParsed(found)
end

-- мьютекс опроса: если прошлый тик ещё ждёт таймауты/кандидаты — новый
-- не стартует, чтобы вызовы не плодились в очередь на каждую секунду
local rolePollBusy = false
local function updateServerRolesSafe()
    if rolePollBusy then return end
    rolePollBusy = true
    local ok, err = pcall(updateServerRoles)
    rolePollBusy = false
    if not ok then
        print("[PERMABAN] roles: ошибка опроса: " .. tostring(err))
    end
end

-- фоновый опрос раз в секунду, НЕ привязан к тогглу Chams: роли нужны
-- и списку FLING. Каждый тик — в ОТДЕЛЬНОМ потоке: даже если что-то
-- внутри зависнет, цикл продолжит тикать (двойная страховка к таймауту
-- внутри invokeRemote). Скан Value-объектов — каждый второй тик
task.spawn(function()
    local tick2 = 0
    while true do
        task.wait(1)
        if clientAlive() then
            tick2 = tick2 + 1
            task.spawn(function()
                updateServerRolesSafe()
                if tick2 % 2 == 0 then
                    pcall(function() applyParsed(rolesFromValues()) end)
                end
            end)
        end
    end
end)

-- роль ТОЛЬКО с сервера (v2.35): нет записи — нет подсветки.
-- Никаких дефолтных «Innocent» и сканов рюкзака — единый источник
local function roleOf(pl)
    return serverRoles[pl.Name]
end

-- v2.35: оружейные вачеры ролей удалены (хедшот: роли — только с сервера).
-- Оружейные проверки аима НЕ тронуты: localHasGun/localHasKnife проверяют
-- ТВОЁ оружие, charHasWeapon — нож ЦЕЛИ в персонаже; это не роли

local function styleHighlight(h, cfg)
    h.FillColor = cfg.Color
    h.OutlineColor = cfg.Color
    h.FillTransparency = math.clamp(cfg.Transparency, 0, 0.99)
    h.OutlineTransparency = 0.1
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end

-- снять всё: с игроков и с дропа (Highlight может висеть и на Handle)
local function clearChams()
    for _, pl in ipairs(Players:GetPlayers()) do
        local char = pl.Character
        if char then
            local h = char:FindFirstChild("PermaBanChams")
            if h then h:Destroy() end
        end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Tool") or obj:IsA("BasePart") then
            -- Highlight может висеть на самом объекте, на Handle и на GunDrop
            local h = obj:FindFirstChild("PermaBanChamsGun")
            if h then h:Destroy() end
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local h2 = handle:FindFirstChild("PermaBanChamsGun")
                if h2 then h2:Destroy() end
            end
        elseif obj:IsA("Model") then
            local h = obj:FindFirstChild("PermaBanChamsGun")
            if h then h:Destroy() end
        end
    end
end

local function makeHighlight(name)
    local h = Instance.new("Highlight")
    h.Name = name
    return h
end

local chamsAcc = 0
RunService.Heartbeat:Connect(function(dt)
    -- при выходе с плейса LocalPlayer уничтожается — циклы обязаны
