    -- сама не резолвится — тогда вытащенная текстура спасает)
    local function resolveDecalImage(decalId)
        local ok, objs = pcall(function()
            return game:GetObjects("rbxassetid://" .. tostring(decalId))
        end)
        if not ok or type(objs) ~= "table" or #objs == 0 then
            return nil -- тихо: картинка уже стоит напрямую, это только уточнение
        end
        local decal
        for _, root in ipairs(objs) do
            if root:IsA("Decal") then decal = root; break end
            if not decal then
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("Decal") then decal = d; break end
                end
            end
            if decal then break end
        end
        local tex = decal and decal.Texture
        for _, obj in ipairs(objs) do pcall(function() obj:Destroy() end) end
        if not tex then
            warn("[PERMABAN] в ассете " .. decalId .. " нет декали — это не картинка")
            return nil
        end
        local id = tonumber(tex:match("%d+$") or tex:match("%d+"))
        local url = id and ("rbxassetid://" .. id) or tex
        warn("[PERMABAN] декаль → картинка " .. url)
        return url
    end

