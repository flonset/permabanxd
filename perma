                                    changed = true
                                    break
                                end
                            end
                            for i = #args, 1, -1 do
                                local t = typeof(args[i])
                                if t == "CFrame" then
                                    args[i] = aimCF
                                    changed = true
                                    finalAim = aimCF.Position
                                    break
                                elseif t == "Vector3" then
                                    args[i] = aimCF.Position
                                    changed = true
                                    finalAim = aimCF.Position
                                    break
                                end
                            end
                        elseif silentPoint then
                            for i = #args, 1, -1 do
                                local t = typeof(args[i])
                                if t == "CFrame" then
                                    args[i] = CFrame.new(silentPoint)
                                    changed = true
                                    finalAim = silentPoint
                                    break
                                elseif t == "Vector3" then
                                    args[i] = silentPoint
                                    changed = true
                                    finalAim = silentPoint
                                    break
                                end
                            end
                        end
                        if changed then
                            if finalAim then
                                -- метка для трейсера: показываем реальную траекторию
                                aimShotMark.aim = finalAim
                                aimShotMark.at = os.clock()
                            end
                            if not silentRemoteLogged then
                                silentRemoteLogged = true
                                print("[PERMABAN] Silent Aim: redirect remote '" .. n .. "'")
                            end
                            return callOrig(self, unpack(args))
                        end
                    end
                    -- нож: НИКАКИХ хуков — бросок летит натурально и ловит
                    -- расширенные хитбоксы (экспандер выше)
                end
            end
        end
        return oldNamecall(self, ...)
    end))
end)
