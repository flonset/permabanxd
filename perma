do
    local S = SavedConfig
    local function merge(t, sv)
        if type(t) ~= "table" or type(sv) ~= "table" then return end
        for k, v in pairs(t) do          -- идём по ключам таблицы: мусор из файла не пролезет
            local nv = sv[k]
            if nv ~= nil then
                if typeof and typeof(v) == "Color3" then
                    if type(nv) == "table" and type(nv.__color) == "table" and #nv.__color == 3 then
                        t[k] = Color3.new(nv.__color[1], nv.__color[2], nv.__color[3])
                    end
                elseif type(v) == "table" then
                    merge(v, nv)
                elseif type(v) == type(nv) then
                    t[k] = nv
                end
            end
        end
    end
    merge(hatState, rawget(S, "hat"))
    merge(jumpState, rawget(S, "jump"))
    merge(tracerState, rawget(S, "tracer"))
