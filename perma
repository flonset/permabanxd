-- 2. CHINA HAT (3D конус на слоях)
-- Enum.MeshType.Cone НЕ существует, поэтому конус
-- собираем из тонких колец-цилиндров.
-- ==========================================
local hatState = {
    Enabled = false,
    Hue = 0.8,
    Brightness = 1,
    Transparency = 0,
    SizeX = 1.4,
    SizeY = 1.0
}

local HAT_NAME = "ChinaHatVisual"
local HAT_LAYERS = 14

local function hatColor()
    return Color3.fromHSV(hatState.Hue, 1, math.max(hatState.Brightness, 0.05))
end

local function ApplyHatVisuals(hatModel)
    if not hatModel or not hatModel.Parent then return end
    local head = hatModel.Parent:FindFirstChild("Head")
    if not head then return end

    local baseR = 1.5 * hatState.SizeX
    local totalH = 1.0 * hatState.SizeY
    local thickness = totalH / HAT_LAYERS
    local baseY = head.Size.Y / 2 - 0.05

    for _, ring in ipairs(hatModel:GetChildren()) do
        if ring:IsA("BasePart") then
            local idx = tonumber(string.match(ring.Name, "%d+"))
            if idx then
                local t = (idx - 0.5) / HAT_LAYERS
                local r = baseR * (1 - 0.93 * t)

                ring.Size = Vector3.new(thickness, r * 2, r * 2)
                ring.Color = hatColor()
                ring.Transparency = math.clamp(hatState.Transparency + t * 0.15, 0, 0.99)

                -- Weld: Part0.CFrame * C0 == Part1.CFrame * C1
                local weld = ring:FindFirstChildOfClass("Weld")
                if weld then
                    weld.C0 = CFrame.new(0, baseY + (idx - 0.5) * thickness, 0)
                        * CFrame.Angles(0, 0, math.rad(90))
                end
            end
        end
    end
end

local function RemoveHat(character)
    local old = character:FindFirstChild(HAT_NAME)
    if old then old:Destroy() end
end

local function BuildHat(character)
    RemoveHat(character)
    local head = character:WaitForChild("Head", 10)
    if not head then return end

    local hatModel = Instance.new("Model")
    hatModel.Name = HAT_NAME

    for i = 1, HAT_LAYERS do
        local ring = Instance.new("Part")
        ring.Name = "Ring" .. i
        ring.Shape = Enum.PartType.Cylinder
        ring.CanCollide = false
        ring.CanQuery = false
        ring.CanTouch = false
        ring.Massless = true
        ring.Anchored = false
        ring.CastShadow = false
        ring.Material = Enum.Material.Neon
        ring.TopSurface = Enum.SurfaceType.Smooth
        ring.BottomSurface = Enum.SurfaceType.Smooth
        ring.Parent = hatModel

        local weld = Instance.new("Weld")
        weld.Part0 = head
        weld.Part1 = ring
        weld.Parent = ring
    end

    hatModel.Parent = character
    ApplyHatVisuals(hatModel)
end

local function RefreshHat()
    local character = LocalPlayer.Character
    if not character then return end
    if hatState.Enabled then
        BuildHat(character)
    else
        RemoveHat(character)
    end
end

-- ==========================================
-- 3. JUMP CIRCLE (круги под ногами при прыжке)
-- Отдельная функция: вызвалась — построила круг.
-- Залитый = плоский диск-цилиндр, без заливки =
-- кольцо из 32 сегментов, парит чуть выше пола.
-- Жизнь круга: растёт 0.5 сек → растворяется 1 сек.
-- ==========================================
local jumpState = {
    Enabled = false,
    Hue = 0.55,
    Brightness = 1,
    Transparency = 0.15,
    Filled = true
}

local JUMP_RADIUS = 3
local JUMP_SEGMENTS = 32
local RING_LIFT = 0.05  -- микроподъём, чтобы кольцо не мерцало в текстуре пола

local circleFolder = Instance.new("Folder")
circleFolder.Name = "PermaBan_JumpCircles"
circleFolder.Parent = workspace

local function jumpColor()
    return Color3.fromHSV(jumpState.Hue, 1, math.max(jumpState.Brightness, 0.05))
end

local function makeCirclePart()
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    return p
end

local function spawnJumpCircle(pos)
    if not jumpState.Enabled then return end

    if not jumpState.Filled then
        pos = pos + Vector3.new(0, RING_LIFT, 0)  -- без заливки — выше пола
    end

    local color = jumpColor()
    local baseTransparency = math.clamp(jumpState.Transparency, 0, 0.99)
    local parts = {}
    local growInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if jumpState.Filled then
        local disk = makeCirclePart()
        disk.Shape = Enum.PartType.Cylinder
        disk.Size = Vector3.new(0.05, 0.2, 0.2)
        disk.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
        disk.Color = color
        disk.Transparency = baseTransparency
        disk.Parent = circleFolder
        parts[1] = disk
        TweenService:Create(disk, growInfo, {
            Size = Vector3.new(0.05, JUMP_RADIUS * 2, JUMP_RADIUS * 2)
        }):Play()
    else
        local segLen = (2 * math.pi * JUMP_RADIUS / JUMP_SEGMENTS) * 1.15
        for i = 1, JUMP_SEGMENTS do
            local ang = (i / JUMP_SEGMENTS) * math.pi * 2
            local seg = makeCirclePart()
            seg.Size = Vector3.new(0.05, 0.05, 0.05)
            seg.CFrame = CFrame.new(pos)
            seg.Color = color
            seg.Transparency = baseTransparency
            seg.Parent = circleFolder
            parts[#parts + 1] = seg

            local finalPos = pos + Vector3.new(math.cos(ang), 0, math.sin(ang)) * JUMP_RADIUS
            TweenService:Create(seg, growInfo, {
                Size = Vector3.new(segLen, 0.05, 0.14),
                CFrame = CFrame.new(finalPos) * CFrame.Angles(0, -ang - math.rad(90), 0)  -- поворот по касательной, иначе сегменты торчат звёздой
            }):Play()
        end
    end

    task.delay(0.5, function()
        for _, p in ipairs(parts) do
            TweenService:Create(p, TweenInfo.new(1, Enum.EasingStyle.Linear), {
                Transparency = 1
            }):Play()
        end
    end)
    task.delay(1.6, function()
        for _, p in ipairs(parts) do
            if p and p.Parent then p:Destroy() end
        end
    end)
end

local function bindJumpCircle(character)
    local hum = character:WaitForChild("Humanoid", 10)
    if not hum then return end
    hum.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Jumping then
            local root = character:FindFirstChild("HumanoidRootPart")
            if root then
                local r6Legs = hum.RigType == Enum.HumanoidRigType.R6 and 2 or 0  -- R6: HipHeight=0, ноги сами дают 2 studs
                local feetY = root.Position.Y - root.Size.Y / 2 - hum.HipHeight - r6Legs + 0.05
                spawnJumpCircle(Vector3.new(root.Position.X, feetY, root.Position.Z))
            end
        end
    end)
end

-- ==========================================
-- 3B. BULLET TRACER (твой выстрел → трассер)
-- Трассер летит ТОЛЬКО по реальному выстрелу: клик ставит
-- «ожидание выстрела» на SHOT_WINDOW секунд, и когда в пистолете
-- стартует звук (выстрел реально произошёл) — из дула летит
-- луч к точке курсора. Клики без выстрела (перезарядка, пустой
-- огонь) не дают ничего, свой кулдаун не даёт 5 трейсеров в секунду.
-- Луч полностью непрозрачный + широкий «глоу» вокруг.
-- Живёт Lifetime секунд и растворяется в самом конце.
-- Родной луч выстрела игры глушится, чтобы не дублировал наш.
-- ==========================================
local tracerState = {
    Enabled = false,
    Hue = 0.05,
    Brightness = 1,
    Lifetime = 3,
    Width = 0.25
}

local TRACER_MAX_DIST = 1000
local SHOT_WINDOW = 0.4          -- сколько после клика ждём звук выстрела
local TRACER_MIN_INTERVAL = 0.15 -- наш анти-спам между трассерами

local tracerFolder = Instance.new("Folder")
tracerFolder.Name = "PermaBan_Tracers"
tracerFolder.Parent = workspace

-- флаг «внутри собственных рейкастов» (трейсер/groundBelow/форс шот):
-- пока он поднят, __namecall-хук пропускает workspace:Raycast нетронутым —
-- иначе в режиме Silent хук разворачивает наши же LOS-проверки в голову
-- цели, форс шот думает что везде стены и коридор не строится
local rayBypass = false

-- ШИНА АИМА ДЛЯ ТРЕЙСЕРА: aimState/silentPoint объявлены НИЖЕ секции
-- трейсера, upvalue из звукового детекта на них не замкнётся (ушло бы в
-- глобалы и всегда nil). Поэтому кеш-циклы аима и FireServer-хук ПИШУТ
-- сюда фактическую точку полёта пули, а детект выстрела трейсера читает.
--   AIMBUS.enabled/point — живой кеш аима (обновляется каждый кадр)
--   aimShotMark         — точка последнего redirected-выстрела + os.clock()
local AIMBUS = { enabled = false, point = nil }
local aimShotMark = { aim = nil, at = 0 }

local function tracerColor()
    return Color3.fromHSV(tracerState.Hue, 1, math.max(tracerState.Brightness, 0.05))
end

-- рисует один трассер: дуло → точка попадания.
-- 3D-ВЕРСИЯ: настоящие неоновые парты, вытянутые по вектору выстрела —
-- видны с любого ракурса с честным объёмом и блумом, а не плоский
-- billboard-луч. Два слоя: ядро и широкая полупрозрачная «глоу» вокруг
local function spawnTracer(origin, hitPos)
    local life = math.clamp(tracerState.Lifetime, 0.1, 10)
    local width = math.clamp(tracerState.Width, 0.02, 2)
    local color = tracerColor()
    local dist = (hitPos - origin).Magnitude
    if dist < 0.5 then return end
    local mid = (origin + hitPos) * 0.5
    local cf = CFrame.lookAt(mid, hitPos)

    local function makePart(w, transparency)
        local p = Instance.new("Part")
        p.Name = "Tracer3D"
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false
        p.Material = Enum.Material.Neon
        p.Color = color
        p.Transparency = transparency
        p.Size = Vector3.new(w, w, dist)
        p.CFrame = cf
        p.Parent = tracerFolder
        return p
    end

    local core = makePart(width, 0)              -- сам луч, непрозрачный
    local glow = makePart(width * 3, 0.85)       -- объёмная аура вокруг

    -- растворяется только в самом конце жизни
    task.delay(life * 0.85, function()
        local ti = TweenInfo.new(life * 0.15, Enum.EasingStyle.Linear)
        if core.Parent then TweenService:Create(core, ti, { Transparency = 1 }):Play() end
        if glow.Parent then TweenService:Create(glow, ti, { Transparency = 1 }):Play() end
    end)
    task.delay(life, function()
        core:Destroy()
        glow:Destroy()
    end)
end

-- направление выстрела: берём луч камера→курсор как ВЕКТОР, а трассируем
-- от ДУЛА. Раньше точка искалась из камеры и трассер шёл дуло→точку
-- мыши — получался излом, направление врало. Теперь луч из дула строго
-- параллелен взгляду — трассер лежит на реальной траектории пули
local function computeHitPos(char, muzzle)
    local cam = workspace.CurrentCamera
    local mouse = LocalPlayer:GetMouse()
    if not cam or not mouse.Hit then return nil end
    local dir = mouse.Hit.Position - cam.CFrame.Position
    if dir.Magnitude < 0.1 then return nil end
    dir = dir.Unit
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, tracerFolder }
    local o = muzzle or cam.CFrame.Position
    rayBypass = true
    local okR, result = pcall(workspace.Raycast, workspace, o, dir * TRACER_MAX_DIST, params)
    rayBypass = false
    result = okR and result or nil
    return result and result.Position or (o + dir * TRACER_MAX_DIST)
end

-- === детект выстрела ===
local pendingShot = nil   -- { origin = BasePart, expires = number }
local lastTracerAt = 0

-- глушим родной луч выстрела игры, пока наш трассер работает:
-- новые Beam в воркспейсе выключаем, свои не трогаем
local suppressNative = false
workspace.DescendantAdded:Connect(function(obj)
    if not suppressNative then return end
    if obj:IsA("Beam") and not obj:IsDescendantOf(tracerFolder) then
        task.defer(function()
            if obj and obj.Parent then obj.Enabled = false end
        end)
    end
end)

-- ловим старт звука в оружии = реальный выстрел
local function watchToolSounds(tool)
    local function hookSound(snd)
        if not snd:IsA("Sound") then return end
        if snd:GetAttribute("PermaBanHooked") then return end
        snd:SetAttribute("PermaBanHooked", true)
        snd:GetPropertyChangedSignal("Playing"):Connect(function()
            if not snd.Playing then return end
            if not tracerState.Enabled then return end
            if not pendingShot then return end
            if tick() > pendingShot.expires then pendingShot = nil; return end
            if tick() - lastTracerAt < TRACER_MIN_INTERVAL then return end

            local char = LocalPlayer.Character
            -- звук должен быть нашим (внутри нашего персонажа) и в тулке
            if not char or not snd:IsDescendantOf(char) then return end
            local inTool = false
            local p = snd.Parent
            while p and p ~= char do
                if p:IsA("Tool") then inTool = true; break end
                p = p.Parent
            end
            if not inTool then return end

            -- выстрел реален: снимаем с ожидания и рисуем
            lastTracerAt = tick()
            local originPart = pendingShot.origin
            pendingShot = nil
            suppressNative = true
            task.delay(0.25, function() suppressNative = false end)

            local muzzle = (originPart and originPart.Parent) and originPart.Position or nil
            if not muzzle and char then
                local head = char:FindFirstChild("Head")
                muzzle = head and head.Position or nil
            end
            -- КУДА РИСУЕМ: если аим включён и перенаправил выстрел — трейсер
            -- летит в ТОЧКУ АИМА (упреждённая голова цели), а не под курсор;
            -- форс шот без аима — в точку коридора из FireServer-хука;
            -- иначе — честный рейкаст камера→курсор, как раньше
            local hitPos
            if AIMBUS.enabled and AIMBUS.point then
                hitPos = AIMBUS.point
            elseif aimShotMark.aim and os.clock() - aimShotMark.at <= 0.35 then
                hitPos = aimShotMark.aim
            else
                hitPos = muzzle and computeHitPos(char, muzzle) or nil
            end
            if muzzle and hitPos then
                spawnTracer(muzzle, hitPos)
            end
        end)
    end
    for _, d in ipairs(tool:GetDescendants()) do hookSound(d) end
    tool.DescendantAdded:Connect(hookSound)
end

-- клик с тулом в руках → ставим ожидание выстрела
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not tracerState.Enabled then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    local handle = tool and tool:FindFirstChild("Handle")
    if not tool or not handle then return end

    pendingShot = { origin = handle, expires = tick() + SHOT_WINDOW }
    suppressNative = true
    task.delay(SHOT_WINDOW + 0.25, function() suppressNative = false end)
end)

-- хукаем все тулки персонажа: текущие и будущие
local function bindToolWatcher(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then watchToolSounds(child) end
    end)
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then watchToolSounds(child) end
    end
end
LocalPlayer.CharacterAdded:Connect(bindToolWatcher)
if LocalPlayer.Character then bindToolWatcher(LocalPlayer.Character) end

