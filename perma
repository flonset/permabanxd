-- Запускает пак: подмена анимаций внутри Animate.
-- Animate сам перезагрузит свои треки на новые ID.
local function applyPack(packName)
    local char = LocalPlayer.Character
    if not char then return end
    local animate = char:FindFirstChild("Animate")
    if not animate then return end
    local pack = ANIM_PACKS[packName]
    if not pack then return end

    -- на новом персонаже старые сохранения не нужны
    if savedAnims and savedAnims.char ~= char then savedAnims = nil end

    -- запоминаем оригиналы один раз
    if not savedAnims then
        savedAnims = { char = char, ids = {} }
        for setName in pairs(pack) do
            local set = animate:FindFirstChild(setName)
            if set then
                savedAnims.ids[setName] = {}
                for _, a in ipairs(set:GetChildren()) do
                    if a:IsA("Animation") then
                        savedAnims.ids[setName][a.Name] = a.AnimationId
                    end
                end
            end
        end
    end

    for setName, animId in pairs(pack) do
        local set = animate:FindFirstChild(setName)
        if set then
            for _, a in ipairs(set:GetChildren()) do
                if a:IsA("Animation") then
                    a.AnimationId = "rbxassetid://" .. tostring(animId)
                end
            end
        end
    end

    stopAllTracks(char)   -- чтобы пак заиграл сразу, а не после смены состояния
end

-- Останавливает пак и возвращает стандартные анимации
local function teardownPack()
    local char = LocalPlayer.Character
    if not char then return end
    local animate = char:FindFirstChild("Animate")
    if animate and savedAnims and savedAnims.char == char then
        for setName, childs in pairs(savedAnims.ids) do
            local set = animate:FindFirstChild(setName)
            if set then
                for childName, id in pairs(childs) do
                    local a = set:FindFirstChild(childName)
                    if a and a:IsA("Animation") then
                        a.AnimationId = id
                    end
                end
            end
        end
    end
    savedAnims = nil
    stopAllTracks(char)
end

